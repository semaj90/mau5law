		"domains": ["backend", "forms"],
		"scope": "ts",
		"risk": "medium",
		"requires": ["contains:sveltekit-superforms"],
		"patchKind": "replace"
	},
	{
		"id": "sveltekit-error",
		"description": "Fix error() object literals to json() or string",
		"regex": "throw\\s+error\\(\\d+,\\s*\\{[^}]*message:",
		"fixTemplate": "return json({ ... }, { status: ... })",
		"priority": 6,
		"domains": ["backend", "api"],
		"scope": "ts",
		"risk": "medium",
		"requires": ["contains:throw error("],
		"patchKind": "codemod"
	},
	{
		"id": "lucia-session-adapter",
		"description": "Fix Lucia PostgreSQLSessionTable type mismatch",
		"regex": "new\\s+Lucia\\([^)]*DrizzlePostgreSQLAdapter",
		"fixTemplate": "new DrizzlePostgreSQLAdapter(db, sessions as any, ...)",
