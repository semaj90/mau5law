{
  "extends": "./.svelte-kit/tsconfig.json",
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": false,
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": false,
    "noImplicitAny": false,
    "noImplicitReturns": false,
    "noImplicitThis": false,
    "strictNullChecks": false,
    "strictFunctionTypes": false,
    "strictBindCallApply": false,
    "strictPropertyInitialization": false,
    "noImplicitOverride": false,
    "exactOptionalPropertyTypes": false,
    "noUncheckedIndexedAccess": false,
    "noPropertyAccessFromIndexSignature": false,
    "suppressImplicitAnyIndexErrors": true,
    "suppressExcessPropertyErrors": true,
    "types": ["svelte", "vite/client", "@sveltejs/kit", "@webgpu/types", "node"],
    "lib": ["es2022", "DOM", "DOM.Iterable"],
    "verbatimModuleSyntax": false,
    "noEmit": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "include": ["src", "src/**/*.ts", "src/**/*.js", "src/**/*.svelte"],
  "exclude": [
    "node_modules",
    "build",
    ".svelte-kit",
    "dist",
    "archived-components/**",
    "src/tests/**",
    "src/stories/**",
    "src/lib/experimental/**",
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/node_modules/**",
    "src/lib/server/thread-safe-postgres.ts",
    "src/lib/server/gpu-thread-coordinator.ts",
    "src/lib/services/gpu-cache-orchestrator.ts",
    "src/lib/services/webgpu-texture-streaming.ts",
    "src/lib/types/drizzle-enhanced.d.ts",
    "src/lib/shims/**",
    "src/proto/**",
    "src/grpc/**",
    "src/flatbuf/**",
    "src/wasm/**",
    "src/workers/**",
    "**/*.worker.ts",
    "**/*.sw.ts",
    "**/service-worker.ts"
  ]
}
