# TensorRT Production Dockerfile for gemma3-legal:latest
# Optimized for RTX 3060 Ti with Docker Desktop integration

FROM nvcr.io/nvidia/tensorrt:24.09-py3

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    wget \
    build-essential \
    cmake \
    git \
    python3-dev \
    libssl-dev \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

# Install Go 1.21+ for TensorRT integration services
RUN wget https://go.dev/dl/go1.23.4.linux-amd64.tar.gz && \
    tar -C /usr/local -xzf go1.23.4.linux-amd64.tar.gz && \
    rm go1.23.4.linux-amd64.tar.gz

ENV PATH="/usr/local/go/bin:${PATH}"
ENV GOPATH="/go"
ENV PATH="${GOPATH}/bin:${PATH}"

# Install Node.js 20+ for WebAssembly integration
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y nodejs

# Copy TensorRT requirements and install Python dependencies
COPY go-microservice/tensorrt/requirements.txt /app/
RUN pip install --no-cache-dir -r requirements.txt

# Install additional production dependencies
RUN pip install --no-cache-dir \
    onnx-graphsurgeon \
    polygraphy \
    colored \
    psycopg2-binary \
    redis \
    boto3

# Copy TensorRT source code
COPY go-microservice/tensorrt/ /app/tensorrt/
COPY go-microservice/pkg/ /app/pkg/

# Copy Go module files
COPY go.mod go.sum /app/

# Initialize Go modules and download dependencies
RUN cd /app && go mod download

# Build TensorRT services
RUN cd /app && \
    go build -o tensorrt_xstate_integration ./tensorrt/tensorrt_xstate_integration.go && \
    go build -o engine_manager ./tensorrt/engine_manager.go

# Compile TensorRT C++ wrapper
RUN cd /app/tensorrt && \
    g++ -O3 -std=c++17 \
    -I/usr/local/cuda/include \
    -I/usr/include/x86_64-linux-gnu \
    -L/usr/local/cuda/lib64 \
    -L/usr/lib/x86_64-linux-gnu \
    tensorrt_wrapper.cpp \
    -lnvinfer -lnvinfer_plugin -lcudart -lcuda \
    -o tensorrt_wrapper

# Copy WebAssembly integration files
COPY sveltekit-frontend/src/lib/ai/ /app/webasm/
COPY sveltekit-frontend/src/lib/adapters/ /app/adapters/

# Create directories for models and cache
RUN mkdir -p /app/models /app/tensorrt_cache /app/logs

# Create model conversion and optimization scripts
COPY go-microservice/tensorrt/model_converter.py /app/
COPY go-microservice/tensorrt/convert_all_models.sh /app/
RUN chmod +x /app/convert_all_models.sh

# Create startup script for production
RUN cat > /app/start_tensorrt_production.sh << 'EOF'
#!/bin/bash
set -e

echo "🚀 Starting TensorRT Legal AI Production Service"
echo "==============================================="

# Check GPU availability
echo "🔍 Checking GPU access..."
nvidia-smi || (echo "❌ GPU not accessible" && exit 1)

# Optimize for RTX 3060 Ti
export CUDA_VISIBLE_DEVICES=0
export NVIDIA_TF32_OVERRIDE=1
export TORCH_BACKENDS_CUDNN_BENCHMARK=true

# Start XState GPU lifecycle integration
echo "🔄 Starting XState GPU lifecycle management..."
./tensorrt_xstate_integration &
XSTATE_PID=$!

# Start TensorRT engine manager
echo "⚡ Starting TensorRT engine manager..."
./engine_manager &
ENGINE_PID=$!

# Start model optimization if models exist
if [ -d "/app/models" ] && [ "$(ls -A /app/models)" ]; then
    echo "🔧 Optimizing existing models for TensorRT..."
    python3 /app/model_converter.py --input-dir /app/models --output-dir /app/tensorrt_cache
fi

# Health check endpoint
echo "🏥 Starting health check service..."
python3 - << 'HEALTH_EOF' &
from http.server import HTTPServer, BaseHTTPRequestHandler
import json
import psutil
import subprocess
import os

class HealthHandler(BaseHTTPRequestHandler):
    def do_GET(self):
        if self.path == '/health':
            try:
                # Check GPU
                result = subprocess.run(['nvidia-smi', '--query-gpu=utilization.gpu,memory.used,memory.total', '--format=csv,noheader,nounits'],
                                      capture_output=True, text=True, timeout=5)
                gpu_stats = result.stdout.strip().split(', ')

                health_data = {
                    'status': 'healthy',
                    'gpu_utilization': f"{gpu_stats[0]}%",
                    'gpu_memory_used': f"{gpu_stats[1]}MB",
                    'gpu_memory_total': f"{gpu_stats[2]}MB",
                    'cpu_percent': psutil.cpu_percent(),
                    'memory_percent': psutil.virtual_memory().percent,
                    'tensorrt_cache': len(os.listdir('/app/tensorrt_cache')) if os.path.exists('/app/tensorrt_cache') else 0
                }

                self.send_response(200)
                self.send_header('Content-type', 'application/json')
                self.end_headers()
                self.wfile.write(json.dumps(health_data).encode())
            except Exception as e:
                self.send_response(500)
                self.send_header('Content-type', 'application/json')
                self.end_headers()
                self.wfile.write(json.dumps({'status': 'unhealthy', 'error': str(e)}).encode())

httpd = HTTPServer(('0.0.0.0', 8100), HealthHandler)
httpd.serve_forever()
HEALTH_EOF

echo "✅ TensorRT Legal AI Production Service started successfully"
echo "📊 Health endpoint: http://localhost:8100/health"
echo "🔗 XState integration: http://localhost:8098"
echo "⚡ TensorRT API: http://localhost:8099"

# Keep services running
wait $XSTATE_PID $ENGINE_PID
EOF

RUN chmod +x /app/start_tensorrt_production.sh

# Expose ports
EXPOSE 8098 8099 8100

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8100/health || exit 1

# Start TensorRT production service
CMD ["/app/start_tensorrt_production.sh"]