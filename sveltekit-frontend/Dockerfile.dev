# Development Dockerfile for SvelteKit Legal AI Frontend
FROM node:18-alpine

# Install dependencies for better performance
RUN apk add --no-cache git python3 make g++

# Set working directory
WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies with dev dependencies (skip problematic packages)
RUN npm cache clean --force && rm -f package-lock.json && npm install --legacy-peer-deps

# Copy source code
COPY . .

# Expose Vite dev server port
EXPOSE 5173

# Set environment variables for development
ENV NODE_ENV=development
ENV VITE_DEV=true
ENV HOST=0.0.0.0
ENV PORT=5173

# Enable GPU optimizations
ENV ENABLE_GPU=true
ENV RTX_3060_OPTIMIZATION=true
ENV CONTEXT7_MULTICORE=true
ENV OLLAMA_GPU_LAYERS=30

# Start Vite dev server (without local Redis startup)
CMD ["npm", "run", "dev:quic:simple", "--", "--host", "0.0.0.0", "--port", "5173"]