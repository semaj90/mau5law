# FlashAttention Docker Build for RTX 3060 Ti CUDA 13.0
FROM nvidia/cuda:12.1-devel-ubuntu22.04

# Set environment variables for CUDA
ENV CUDA_HOME=/usr/local/cuda
ENV PATH=$CUDA_HOME/bin:$PATH
ENV LD_LIBRARY_PATH=$CUDA_HOME/lib64:$LD_LIBRARY_PATH
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility

# Install system dependencies
RUN apt-get update && apt-get install -y \
    python3-pip \
    python3-dev \
    git \
    wget \
    build-essential \
    cmake \
    ninja-build \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
RUN pip3 install torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cu121

# Set PyTorch CUDA architecture for RTX 3060 Ti (compute capability 8.6)
ENV TORCH_CUDA_ARCH_LIST="8.6"

# Clone and install FlashAttention
WORKDIR /opt
RUN git clone https://github.com/Dao-AILab/flash-attention.git
WORKDIR /opt/flash-attention

# Build FlashAttention with specific optimizations for RTX 3060 Ti
RUN pip3 install packaging wheel
RUN MAX_JOBS=4 pip3 install flash-attn --no-build-isolation

# Verify installation
RUN python3 -c "import flash_attn; print('✅ FlashAttention installed successfully')"

# Create TensorRT integration directory
WORKDIR /app/tensorrt
COPY tensorrt-legal/ .

# Install additional dependencies for legal AI integration
RUN pip3 install \
    transformers \
    accelerate \
    datasets \
    tokenizers \
    numpy \
    scipy \
    scikit-learn

# Set up the working directory
WORKDIR /app

# Copy TensorRT legal AI integration files
COPY tensorrt-legal/ ./tensorrt-legal/

# Build the C++ components with CUDA and FlashAttention support
RUN nvcc -std=c++17 -O3 -arch=sm_86 \
    -I/usr/local/cuda/include \
    -I/opt/flash-attention/csrc \
    -L/usr/local/cuda/lib64 \
    -lcudart -lcublas -lcurand \
    -o moogle_synthesizer \
    ./tensorrt-legal/moogle_graph_synthesizer_stage6.cpp

# Create startup script
RUN echo '#!/bin/bash' > /app/start.sh && \
    echo 'echo "🚀 FlashAttention + TensorRT Legal AI Container Starting..."' >> /app/start.sh && \
    echo 'echo "GPU Info:"' >> /app/start.sh && \
    echo 'nvidia-smi' >> /app/start.sh && \
    echo 'echo "✅ FlashAttention Version:"' >> /app/start.sh && \
    echo 'python3 -c "import flash_attn; print(flash_attn.__version__)"' >> /app/start.sh && \
    echo 'echo "🎯 Starting Legal AI Moogle Graph Synthesizer..."' >> /app/start.sh && \
    echo './moogle_synthesizer' >> /app/start.sh && \
    chmod +x /app/start.sh

EXPOSE 8097 8098 8099

CMD ["/app/start.sh"]