# Phase 66 - Unified MCP Server Container
# ESM + TSX + SIMD + Redis + pgvector + Ollama + TensorRT-LLM Integration

FROM node:22-bookworm-slim AS base

# Install system dependencies for SIMD operations and native modules
RUN apt-get update && apt-get install -y \
    python3 python3-distutils python3-venv python3-pip \
    make g++ gcc git pkg-config curl \
    redis-tools postgresql-client \
    mesa-utils libgl1-mesa-dev libglu1-mesa-dev \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf python3 /usr/bin/python

# Install Python packages permanently (TensorRT-LLM ecosystem)
RUN pip install --no-cache-dir tensorrt_llm onnxruntime numpy torch

# Set permanent TensorRT library path
ENV LD_LIBRARY_PATH=/usr/local/tensorrt/targets/x86_64-linux-gnu/lib:${LD_LIBRARY_PATH}

# Create non-root user for security
RUN groupadd -g 1001 nodejs && \
    useradd -s /bin/bash -u 1001 -g nodejs mcp && \
    mkdir -p /home/mcp && \
    chown -R mcp:nodejs /home/mcp

# Set working directory
WORKDIR /app

# Copy package files for dependency installation
COPY package*.json ./
COPY tsconfig.json ./

# Install dependencies (skip problematic native modules)
RUN npm ci --only=production --legacy-peer-deps --ignore-scripts && npm cache clean --force

# Copy source code with proper ownership
COPY --chown=mcp:nodejs src/ ./src/
COPY --chown=mcp:nodejs scripts/ ./scripts/
COPY --chown=mcp:nodejs go-microservice/ ./go-microservice/
COPY --chown=mcp:nodejs python-services/ ./python-services/
COPY --chown=mcp:nodejs tsconfig.json ./

# Switch to non-root user
USER mcp
WORKDIR /app

# Expose MCP server port
EXPOSE 3003

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:3003/mcp/health || exit 1

# Start the MCP server
CMD ["npx", "tsx", "src/server.ts"]