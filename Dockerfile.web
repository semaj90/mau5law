# Phase 70: Web Crawl Service Dockerfile
FROM python:3.12-slim

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy Python service
COPY python-services/web_crawl_service.py /app/

# Install Python dependencies
RUN pip install --no-cache-dir fastapi uvicorn aiohttp beautifulsoup4 lxml

# Expose port
EXPOSE 8103

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8103/health || exit 1

# Run service
CMD ["python", "web_crawl_service.py"]