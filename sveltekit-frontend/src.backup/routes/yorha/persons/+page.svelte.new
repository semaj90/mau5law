<script lang="ts">
  import { onMount } from 'svelte';
  import { goto } from '$app/navigation';
  import { enhance } from '$app/forms';
  import { invalidateAll } from '$app/navigation';

  // Bits-UI v2 imports
  import { Button } from '$lib/components/ui/button';
  import { Input } from '$lib/components/ui/input';
  import { Card } from '$lib/components/ui/card';
  import { Badge } from '$lib/components/ui/badge';
  import { Alert } from '$lib/components/ui/alert';
  import { Dialog } from '$lib/components/ui/dialog';
  import { Select } from '$lib/components/ui/select';
  import { Tooltip } from '$lib/components/ui/tooltip';

  // Icons
  import IconSearch from '~icons/lucide/search';
  import IconPlus from '~icons/lucide/plus';
  import IconEdit from '~icons/lucide/edit-3';
  import IconTrash from '~icons/lucide/trash-2';
  import IconEye from '~icons/lucide/eye';
  import IconAlertTriangle from '~icons/lucide/alert-triangle';
  import IconCheckCircle from '~icons/lucide/check-circle';
  import IconX from '~icons/lucide/x';
  import IconBrain from '~icons/lucide/brain';
  import IconTarget from '~icons/lucide/target';

  // Types
  interface Person {
    id: string;
    name: string;
    alias?: string;
    threat_level: 'low' | 'medium' | 'high' | 'critical';
    status: 'surveillance' | 'wanted' | 'active' | 'cleared';
    description: string;
    last_seen?: string;
    location?: string;
    photo_url?: string;
    ai_analysis?: {
      risk_score: number;
      patterns: string[];
      recommendations: string[];
      last_analyzed: string;
    };
    cases?: string[];
    created_at: string;
    updated_at: string;
  }

  interface PersonForm {
    name: string;
    alias: string;
    threat_level: 'low' | 'medium' | 'high' | 'critical';
    status: 'surveillance' | 'wanted' | 'active' | 'cleared';
    description: string;
    last_seen: string;
    location: string;
  }

  // Reactive state with Svelte 5 runes
  let persons = $state<Person[]>([]);
  let filteredPersons = $derived(() => {
    if (!searchQuery && threatFilter === 'all') return persons;

    return persons.filter(person => {
      const matchesSearch = !searchQuery ||
        person.name.toLowerCase().includes(searchQuery.toLowerCase()) ||
        person.alias?.toLowerCase().includes(searchQuery.toLowerCase()) ||
        person.description.toLowerCase().includes(searchQuery.toLowerCase()) ||
        person.location?.toLowerCase().includes(searchQuery.toLowerCase());

      const matchesThreat = threatFilter === 'all' || person.threat_level === threatFilter;

      return matchesSearch && matchesThreat;
    });
  });

  let searchQuery = $state('');
  let threatFilter = $state<'all' | 'low' | 'medium' | 'high' | 'critical'>('all');
  let isLoading = $state(true);
  let error = $state<string | null>(null);

  // Modal states
  let showNewPersonModal = $state(false);
  let showEditModal = $state(false);
  let showDeleteConfirm = $state(false);
  let showAIAnalysis = $state(false);
  let selectedPerson = $state<Person | null>(null);

  // Form state
  let newPerson = $state<PersonForm>({
    name: '',
    alias: '',
    threat_level: 'low',
    status: 'surveillance',
    description: '',
    last_seen: '',
    location: '',
  });

  let editPerson = $state<PersonForm>({
    name: '',
    alias: '',
    threat_level: 'low',
    status: 'surveillance',
    description: '',
    last_seen: '',
    location: '',
  });

  // Stats derived from data
  let stats = $derived(() => {
    const total = persons.length;
    const critical = persons.filter(p => p.threat_level === 'critical').length;
    const active = persons.filter(p => p.status === 'active').length;
    const wanted = persons.filter(p => p.status === 'wanted').length;

    return { total, critical, active, wanted };
  });

  // Load persons data
  async function loadPersons() {
    try {
      isLoading = true;
      error = null;

      const response = await fetch('/api/persons');
      if (!response.ok) throw new Error('Failed to load persons');

      persons = await response.json();
    } catch (err) {
      error = err instanceof Error ? err.message : 'Unknown error occurred';
      console.error('Error loading persons:', err);
    } finally {
      isLoading = false;
    }
  }

  // Add new person
  async function handleAddPerson() {
    if (!newPerson.name.trim()) return;

    try {
      const response = await fetch('/api/persons', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(newPerson),
      });

      if (!response.ok) throw new Error('Failed to add person');

      const addedPerson = await response.json();
      persons = [...persons, addedPerson];

      // Reset form and close modal
      newPerson = {
        name: '',
        alias: '',
        threat_level: 'low',
        status: 'surveillance',
        description: '',
        last_seen: '',
        location: '',
      };
      showNewPersonModal = false;
    } catch (err) {
      error = err instanceof Error ? err.message : 'Failed to add person';
      console.error('Error adding person:', err);
    }
  }

  // Edit person
  function handleEditPerson(person: Person) {
    selectedPerson = person;
    editPerson = {
      name: person.name,
      alias: person.alias || '',
      threat_level: person.threat_level,
      status: person.status,
      description: person.description,
      last_seen: person.last_seen || '',
      location: person.location || '',
    };
    showEditModal = true;
  }

  async function handleUpdatePerson() {
    if (!selectedPerson || !editPerson.name.trim()) return;

    try {
      const response = await fetch(`/api/persons/${selectedPerson.id}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(editPerson),
      });

      if (!response.ok) throw new Error('Failed to update person');

      const updatedPerson = await response.json();
      persons = persons.map(p => p.id === selectedPerson!.id ? updatedPerson : p);

      showEditModal = false;
      selectedPerson = null;
    } catch (err) {
      error = err instanceof Error ? err.message : 'Failed to update person';
      console.error('Error updating person:', err);
    }
  }

  // Delete person
  function handleDeletePerson(person: Person) {
    selectedPerson = person;
    showDeleteConfirm = true;
  }

  async function confirmDelete() {
    if (!selectedPerson) return;

    try {
      const response = await fetch(`/api/persons/${selectedPerson.id}`, {
        method: 'DELETE',
      });

      if (!response.ok) throw new Error('Failed to delete person');

      persons = persons.filter(p => p.id !== selectedPerson!.id);
      showDeleteConfirm = false;
      selectedPerson = null;
    } catch (err) {
      error = err instanceof Error ? err.message : 'Failed to delete person';
      console.error('Error deleting person:', err);
    }
  }

  // AI Analysis
  async function analyzePerson(person: Person) {
    try {
      const response = await fetch(`/api/persons/${person.id}/analyze`, {
        method: 'POST',
      });

      if (!response.ok) throw new Error('Failed to analyze person');

      const analysis = await response.json();

      // Update person with AI analysis
      persons = persons.map(p =>
        p.id === person.id
          ? { ...p, ai_analysis: analysis }
          : p
      );
    } catch (err) {
      error = err instanceof Error ? err.message : 'AI analysis failed';
      console.error('Error analyzing person:', err);
    }
  }

  function showAIAnalysisModal(person: Person) {
    selectedPerson = person;
    showAIAnalysis = true;
  }

  // Threat level styling
  function getThreatColor(level: string) {
    switch (level) {
      case 'critical': return 'destructive';
      case 'high': return 'destructive';
      case 'medium': return 'secondary';
      case 'low': return 'outline';
      default: return 'outline';
    }
  }

  function getStatusColor(status: string) {
    switch (status) {
      case 'wanted': return 'destructive';
      case 'active': return 'default';
      case 'surveillance': return 'secondary';
      case 'cleared': return 'outline';
      default: return 'outline';
    }
  }

  // Initialize
  onMount(() => {
    loadPersons();
  });
</script>

<svelte:head>
  <title>YoRHa Persons of Interest - Legal AI Platform</title>
</svelte:head>

<div class="yorha-interface">
  <!-- Sidebar -->
  <aside class="yorha-sidebar">
    <div class="yorha-logo">
      <h1 class="yorha-title">YoRHa</h1>
      <div class="yorha-subtitle">AUTOMATON</div>
      <div class="yorha-subtext">Persons of Interest Database</div>
    </div>

    <nav class="yorha-nav">
      <a href="/yorha/dashboard" class="nav-item">
        <span>Dashboard</span>
      </a>
      <a href="/yorha/persons" class="nav-item persons-active">
        <span>Persons</span>
        <span class="nav-count">{stats.total}</span>
      </a>
      <a href="/yorha/evidence" class="nav-item">
        <span>Evidence</span>
      </a>
      <a href="/yorha/cases" class="nav-item">
        <span>Cases</span>
      </a>
      <a href="/yorha/analysis" class="nav-item">
        <span>AI Analysis</span>
      </a>
    </nav>
  </aside>

  <!-- Main Content -->
  <main class="yorha-main">
    <!-- Header -->
    <header class="persons-header">
      <div class="header-left">
        <h2 class="persons-title">Persons of Interest</h2>
        <div class="persons-subtitle">Database Management System</div>
      </div>

      <Button
        class="bits-btn"
        onclick={() => showNewPersonModal = true}
        size="sm"
      >
        <IconPlus class="w-4 h-4 mr-2" />
        Add Person
      </Button>
    </header>

    <!-- Search Toolbar -->
    <div class="search-toolbar">
      <div class="search-input-wrapper">
        <div class="relative">
          <IconSearch class="search-icon w-4 h-4 text-muted-foreground absolute left-3 top-1/2 transform -translate-y-1/2" />
          <Input
            bind:value={searchQuery}
            placeholder="Search persons by name, alias, description..."
            class="search-input pl-10 w-80"
          />
        </div>

        <Select bind:value={threatFilter}>
          <Select.Trigger class="threat-filter w-40">
            <Select.Value placeholder="Filter by threat" />
          </Select.Trigger>
          <Select.Content>
            <Select.Item value="all">All Threats</Select.Item>
            <Select.Item value="critical">Critical</Select.Item>
            <Select.Item value="high">High</Select.Item>
            <Select.Item value="medium">Medium</Select.Item>
            <Select.Item value="low">Low</Select.Item>
          </Select.Content>
        </Select>
      </div>

      <!-- Stats -->
      <div class="stats-section">
        <div class="stat-item">
          <div class="stat-number">{stats.total}</div>
          <div class="stat-label">Total</div>
        </div>
        <div class="stat-item critical">
          <div class="stat-number">{stats.critical}</div>
          <div class="stat-label">Critical</div>
        </div>
        <div class="stat-item">
          <div class="stat-number">{stats.active}</div>
          <div class="stat-label">Active</div>
        </div>
        <div class="stat-item">
          <div class="stat-number">{stats.wanted}</div>
          <div class="stat-label">Wanted</div>
        </div>
      </div>
    </div>

    <!-- Error Banner -->
    {#if error}
      <Alert class="error-banner" variant="destructive">
        <IconAlertTriangle class="w-4 h-4" />
        <span>{error}</span>
        <Button
          variant="ghost"
          size="sm"
          class="ml-auto"
          onclick={() => error = null}
        >
          <IconX class="w-4 h-4" />
        </Button>
      </Alert>
    {/if}

    <!-- Loading State -->
    {#if isLoading}
      <div class="loading-state">
        <div class="loading-spinner"></div>
        <div>Loading persons database...</div>
      </div>
    {:else if filteredPersons.length === 0}
      <!-- Empty State -->
      <div class="empty-state">
        <IconTarget class="empty-icon" />
        <div class="empty-title">No Persons Found</div>
        <div class="empty-subtitle">
          {#if searchQuery || threatFilter !== 'all'}
            No persons match your current filters.
          {:else}
            Start by adding the first person of interest.
          {/if}
        </div>
        {#if searchQuery || threatFilter !== 'all'}
          <Button
            variant="outline"
            onclick={() => { searchQuery = ''; threatFilter = 'all'; }}
          >
            Clear Filters
          </Button>
        {:else}
          <Button onclick={() => showNewPersonModal = true}>
            <IconPlus class="w-4 h-4 mr-2" />
            Add First Person
          </Button>
        {/if}
      </div>
    {:else}
      <!-- Persons Grid -->
      <div class="persons-grid">
        {#each filteredPersons as person (person.id)}
          <Card class="person-card">
            <div class="person-header">
              <div class="person-photo">
                {#if person.photo_url}
                  <img src={person.photo_url} alt={person.name} class="w-full h-full object-cover" />
                {:else}
                  <div class="photo-placeholder">
                    <IconTarget class="w-8 h-8" />
                  </div>
                {/if}
              </div>

              <div class="person-basic-info">
                <div class="person-name">{person.name}</div>
                {#if person.alias}
                  <div class="person-alias">"{person.alias}"</div>
                {/if}
                <div class="person-id">ID: {person.id.slice(0, 8)}</div>
              </div>
            </div>

            <div class="person-badges">
              <Badge variant={getThreatColor(person.threat_level)} class="threat-badge">
                {person.threat_level.toUpperCase()}
              </Badge>
              <Badge variant={getStatusColor(person.status)} class="status-badge">
                {person.status.toUpperCase()}
              </Badge>
            </div>

            <div class="person-details">
              {#if person.last_seen}
                <div class="detail-row">
                  <span class="detail-label">Last Seen:</span>
                  <span class="detail-value">{new Date(person.last_seen).toLocaleDateString()}</span>
                </div>
              {/if}
              {#if person.location}
                <div class="detail-row">
                  <span class="detail-label">Location:</span>
                  <span class="detail-value">{person.location}</span>
                </div>
              {/if}
            </div>

            {#if person.description}
              <div class="person-description">
                {person.description.length > 100
                  ? person.description.slice(0, 100) + '...'
                  : person.description}
              </div>
            {/if}

            {#if person.cases && person.cases.length > 0}
              <div class="person-cases">
                {#each person.cases.slice(0, 3) as caseId}
                  <Badge variant="outline" class="case-badge">
                    Case {caseId.slice(0, 6)}
                  </Badge>
                {/each}
                {#if person.cases.length > 3}
                  <Badge variant="outline" class="case-badge">
                    +{person.cases.length - 3} more
                  </Badge>
                {/if}
              </div>
            {/if}

            <div class="person-actions">
              <Tooltip.Provider>
                <Tooltip.Root>
                  <Tooltip.Trigger asChild>
                    <Button
                      variant="ghost"
                      size="sm"
                      onclick={() => showAIAnalysisModal(person)}
                      disabled={!person.ai_analysis}
                    >
                      <IconBrain class="w-4 h-4" />
                    </Button>
                  </Tooltip.Trigger>
                  <Tooltip.Content>
                    <p>View AI Analysis</p>
                  </Tooltip.Content>
                </Tooltip.Root>
              </Tooltip.Provider>

              <Tooltip.Provider>
                <Tooltip.Root>
                  <Tooltip.Trigger asChild>
                    <Button
                      variant="ghost"
                      size="sm"
                      onclick={() => analyzePerson(person)}
                    >
                      <IconTarget class="w-4 h-4" />
                    </Button>
                  </Tooltip.Trigger>
                  <Tooltip.Content>
                    <p>Run AI Analysis</p>
                  </Tooltip.Content>
                </Tooltip.Root>
              </Tooltip.Provider>

              <Tooltip.Provider>
                <Tooltip.Root>
                  <Tooltip.Trigger asChild>
                    <Button
                      variant="ghost"
                      size="sm"
                      onclick={() => handleEditPerson(person)}
                    >
                      <IconEdit class="w-4 h-4" />
                    </Button>
                  </Tooltip.Trigger>
                  <Tooltip.Content>
                    <p>Edit Person</p>
                  </Tooltip.Content>
                </Tooltip.Root>
              </Tooltip.Provider>

              <Tooltip.Provider>
                <Tooltip.Root>
                  <Tooltip.Trigger asChild>
                    <Button
                      variant="ghost"
                      size="sm"
                      onclick={() => handleDeletePerson(person)}
                    >
                      <IconTrash class="w-4 h-4" />
                    </Button>
                  </Tooltip.Trigger>
                  <Tooltip.Content>
                    <p>Delete Person</p>
                  </Tooltip.Content>
                </Tooltip.Root>
              </Tooltip.Provider>
            </div>
          </Card>
        {/each}
      </div>
    {/if}
  </main>
</div>

<!-- New Person Modal -->
<Dialog.Root bind:open={showNewPersonModal}>
  <Dialog.Content class="yorha-modal">
    <Dialog.Header>
      <Dialog.Title class="dialog-title">Add New Person of Interest</Dialog.Title>
    </Dialog.Header>

    <div class="modal-form">
      <div class="form-grid">
        <div class="form-field">
          <label class="form-label" for="new-name">FULL NAME</label>
          <Input
            id="new-name"
            placeholder="Enter full name"
            bind:value={newPerson.name}
            required
          />
        </div>
        <div class="form-field">
          <label class="form-label" for="new-alias">ALIAS</label>
          <Input
            id="new-alias"
            placeholder="Known alias or nickname"
            bind:value={newPerson.alias}
          />
        </div>
        <div class="form-field">
          <label class="form-label" for="new-threat">THREAT LEVEL</label>
          <Select bind:value={newPerson.threat_level}>
            <Select.Trigger>
              <Select.Value />
            </Select.Trigger>
            <Select.Content>
              <Select.Item value="low">Low</Select.Item>
              <Select.Item value="medium">Medium</Select.Item>
              <Select.Item value="high">High</Select.Item>
              <Select.Item value="critical">Critical</Select.Item>
            </Select.Content>
          </Select>
        </div>
        <div class="form-field">
          <label class="form-label" for="new-status">STATUS</label>
          <Select bind:value={newPerson.status}>
            <Select.Trigger>
              <Select.Value />
            </Select.Trigger>
            <Select.Content>
              <Select.Item value="surveillance">Under Surveillance</Select.Item>
              <Select.Item value="wanted">Wanted</Select.Item>
              <Select.Item value="active">Active Investigation</Select.Item>
              <Select.Item value="cleared">Cleared</Select.Item>
            </Select.Content>
          </Select>
        </div>
        <div class="form-field">
          <label class="form-label" for="new-last-seen">LAST SEEN DATE</label>
          <Input
            id="new-last-seen"
            type="date"
            bind:value={newPerson.last_seen}
          />
        </div>
        <div class="form-field">
          <label class="form-label" for="new-location">LAST KNOWN LOCATION</label>
          <Input
            id="new-location"
            placeholder="e.g. Downtown District"
            bind:value={newPerson.location}
          />
        </div>
        <div class="form-field" style="grid-column: 1 / -1;">
          <label class="form-label" for="new-description">DESCRIPTION</label>
          <textarea
            id="new-description"
            placeholder="Physical description, known activities, etc."
            rows="4"
            class="yorha-textarea"
            bind:value={newPerson.description}
          ></textarea>
        </div>
      </div>
    </div>

    <Dialog.Footer>
      <Button
        variant="ghost"
        onclick={() => {
          showNewPersonModal = false;
          newPerson = {
            name: '',
            alias: '',
            threat_level: 'low',
            status: 'surveillance',
            description: '',
            last_seen: '',
            location: '',
          };
        }}
      >
        Cancel
      </Button>
      <Button onclick={handleAddPerson} disabled={!newPerson.name.trim()}>
        Add Person
      </Button>
    </Dialog.Footer>
  </Dialog.Content>
</Dialog.Root>

<!-- Edit Person Modal -->
<Dialog.Root bind:open={showEditModal}>
  <Dialog.Content class="yorha-modal">
    <Dialog.Header>
      <Dialog.Title class="dialog-title">Edit Person of Interest</Dialog.Title>
    </Dialog.Header>

    <div class="modal-form">
      <div class="form-grid">
        <div class="form-field">
          <label class="form-label" for="edit-name">FULL NAME</label>
          <Input
            id="edit-name"
            placeholder="Enter full name"
            bind:value={editPerson.name}
            required
          />
        </div>
        <div class="form-field">
          <label class="form-label" for="edit-alias">ALIAS</label>
          <Input
            id="edit-alias"
            placeholder="Known alias or nickname"
            bind:value={editPerson.alias}
          />
        </div>
        <div class="form-field">
          <label class="form-label" for="edit-threat">THREAT LEVEL</label>
          <Select bind:value={editPerson.threat_level}>
            <Select.Trigger>
              <Select.Value />
            </Select.Trigger>
            <Select.Content>
              <Select.Item value="low">Low</Select.Item>
              <Select.Item value="medium">Medium</Select.Item>
              <Select.Item value="high">High</Select.Item>
              <Select.Item value="critical">Critical</Select.Item>
            </Select.Content>
          </Select>
        </div>
        <div class="form-field">
          <label class="form-label" for="edit-status">STATUS</label>
          <Select bind:value={editPerson.status}>
            <Select.Trigger>
              <Select.Value />
            </Select.Trigger>
            <Select.Content>
              <Select.Item value="surveillance">Under Surveillance</Select.Item>
              <Select.Item value="wanted">Wanted</Select.Item>
              <Select.Item value="active">Active Investigation</Select.Item>
              <Select.Item value="cleared">Cleared</Select.Item>
            </Select.Content>
          </Select>
        </div>
        <div class="form-field">
          <label class="form-label" for="edit-last-seen">LAST SEEN DATE</label>
          <Input
            id="edit-last-seen"
            type="date"
            bind:value={editPerson.last_seen}
          />
        </div>
        <div class="form-field">
          <label class="form-label" for="edit-location">LAST KNOWN LOCATION</label>
          <Input
            id="edit-location"
            placeholder="e.g. Downtown District"
            bind:value={editPerson.location}
          />
        </div>
        <div class="form-field" style="grid-column: 1 / -1;">
          <label class="form-label" for="edit-description">DESCRIPTION</label>
          <textarea
            id="edit-description"
            placeholder="Physical description, known activities, etc."
            rows="4"
            class="yorha-textarea"
            bind:value={editPerson.description}
          ></textarea>
        </div>
      </div>
    </div>

    <Dialog.Footer>
      <Button variant="ghost" onclick={() => showEditModal = false}>
        Cancel
      </Button>
      <Button onclick={handleUpdatePerson} disabled={!editPerson.name.trim()}>
        Update Person
      </Button>
    </Dialog.Footer>
  </Dialog.Content>
</Dialog.Root>

<!-- Delete Confirmation Modal -->
<Dialog.Root bind:open={showDeleteConfirm}>
  <Dialog.Content class="yorha-modal">
    <Dialog.Header>
      <Dialog.Title class="dialog-title">Confirm Deletion</Dialog.Title>
    </Dialog.Header>

    <div class="modal-body">
      <p>Are you sure you want to delete <strong>{selectedPerson?.name}</strong> from the database?</p>
      <p class="text-sm text-muted-foreground mt-2">
        This action cannot be undone. All associated data will be permanently removed.
      </p>
    </div>

    <Dialog.Footer>
      <Button variant="ghost" onclick={() => showDeleteConfirm = false}>
        Cancel
      </Button>
      <Button variant="destructive" onclick={confirmDelete}>
        Delete Person
      </Button>
    </Dialog.Footer>
  </Dialog.Content>
</Dialog.Root>

<!-- AI Analysis Modal -->
<Dialog.Root bind:open={showAIAnalysis}>
  <Dialog.Content class="yorha-modal max-w-2xl">
    <Dialog.Header>
      <Dialog.Title class="dialog-title flex items-center gap-2">
        <IconBrain class="w-5 h-5" />
        AI Analysis: {selectedPerson?.name}
      </Dialog.Title>
    </Dialog.Header>

    {#if selectedPerson?.ai_analysis}
      <div class="modal-body space-y-4">
        <div class="analysis-section">
          <h4 class="text-sm font-semibold mb-2">Risk Score</h4>
          <div class="flex items-center gap-2">
            <div class="risk-score text-2xl font-bold" class:text-red-400={selectedPerson.ai_analysis.risk_score > 0.7}>
              {Math.round(selectedPerson.ai_analysis.risk_score * 100)}%
            </div>
            <Badge variant={selectedPerson.ai_analysis.risk_score > 0.7 ? 'destructive' : 'secondary'}>
              {selectedPerson.ai_analysis.risk_score > 0.7 ? 'High Risk' : 'Low Risk'}
            </Badge>
          </div>
        </div>

        <div class="analysis-section">
          <h4 class="text-sm font-semibold mb-2">Detected Patterns</h4>
          <div class="flex flex-wrap gap-2">
            {#each selectedPerson.ai_analysis.patterns as pattern}
              <Badge variant="outline">{pattern}</Badge>
            {/each}
          </div>
        </div>

        <div class="analysis-section">
          <h4 class="text-sm font-semibold mb-2">AI Recommendations</h4>
          <ul class="space-y-1">
            {#each selectedPerson.ai_analysis.recommendations as rec}
              <li class="text-sm flex items-start gap-2">
                <IconCheckCircle class="w-4 h-4 text-green-400 mt-0.5 flex-shrink-0" />
                {rec}
              </li>
            {/each}
          </ul>
        </div>

        <div class="analysis-section">
          <p class="text-xs text-muted-foreground">
            Last analyzed: {new Date(selectedPerson.ai_analysis.last_analyzed).toLocaleString()}
          </p>
        </div>
      </div>
    {:else}
      <div class="modal-body text-center py-8">
        <IconBrain class="w-12 h-12 text-muted-foreground mx-auto mb-4" />
        <p class="text-muted-foreground">No AI analysis available for this person.</p>
        <Button
          class="mt-4"
          onclick={() => {
            if (selectedPerson) analyzePerson(selectedPerson);
            showAIAnalysis = false;
          }}
        >
          Run Analysis
        </Button>
      </div>
    {/if}

    <Dialog.Footer>
      <Button variant="ghost" onclick={() => showAIAnalysis = false}>
        Close
      </Button>
    </Dialog.Footer>
  </Dialog.Content>
</Dialog.Root>

<style>
  .yorha-interface {
    display: flex;
    height: 100vh;
    background: #2a2a2a;
    color: #d4af37;
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
  }

  /* Sidebar */
  .yorha-sidebar {
    width: 200px;
    background: #1a1a1a;
    border-right: 1px solid #3a3a3a;
    display: flex;
    flex-direction: column;
  }

  .yorha-logo {
    padding: 20px 15px;
  }

  .yorha-title,
  .yorha-subtitle {
    font-size: 18px;
    font-weight: bold;
    color: #d4af37;
    line-height: 1;
  }

  .yorha-subtext {
    font-size: 10px;
    color: #888;
    padding-top: 8px;
    border-bottom: 1px solid #3a3a3a;
  }

  .yorha-nav {
    padding: 10px 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding-left: 8px;
  }

  .nav-item {
    display: flex;
    align-items: center;
    padding: 8px 12px;
    color: #888;
    text-decoration: none;
    cursor: pointer;
    transition: background 0.15s, color 0.15s;
    justify-content: space-between;
    font-size: 11px;
  }

  .nav-item:hover {
    background: #2a2a2a;
    color: #d4af37;
  }

  .nav-item.persons-active {
    background: #162016;
    color: #d4af37;
    border-left: 3px solid #d4af37;
    padding-left: 9px;
  }

  .nav-count {
    font-size: 10px;
    background: #d4af37;
    color: #000;
    padding: 1px 6px;
    border-radius: 2px;
  }

  /* Main area */
  .yorha-main {
    flex: 1;
    display: flex;
    flex-direction: column;
    background: #2a2a2a;
    overflow: hidden;
  }

  .persons-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 15px 20px;
    border-bottom: 1px solid #3a3a3a;
    background: #2a2a2a;
  }

  .header-left {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .persons-title {
    font-size: 24px;
    font-weight: bold;
    color: #d4af37;
    margin: 0;
  }

  .persons-subtitle {
    font-size: 12px;
    color: #888;
  }

  /* Search toolbar */
  .search-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 20px;
    background: #242424;
    border-bottom: 1px solid #3a3a3a;
  }

  .search-input-wrapper {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .search-input {
    background: #1a1a1a !important;
    border: 1px solid #555 !important;
    color: #d4af37 !important;
  }

  .threat-filter {
    background: #1a1a1a;
    border: 1px solid #555;
    color: #d4af37;
    padding: 6px 12px;
    font-family: inherit;
    font-size: 12px;
  }

  /* Stats */
  .stats-section {
    display: flex;
    gap: 20px;
    color: #d4af37;
    align-items: center;
  }

  .stat-item {
    text-align: center;
    font-size: 11px;
  }

  .stat-number {
    font-size: 18px;
    font-weight: bold;
    color: #d4af37;
  }

  .stat-item.critical .stat-number {
    color: #ef4444;
  }

  .stat-label {
    color: #888;
  }

  /* Persons grid & cards */
  .persons-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
    gap: 20px;
    padding: 20px;
    overflow-y: auto;
    flex: 1;
  }

  .person-card {
    background: #1a1a2a !important;
    border: 1px solid #3a3a3a !important;
    padding: 16px;
  }

  .person-header {
    display: flex;
    gap: 12px;
    align-items: center;
    margin-bottom: 12px;
  }

  .person-photo {
    width: 60px;
    height: 60px;
    border-radius: 4px;
    overflow: hidden;
    background: #2a2a2a;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .photo-placeholder {
    color: #666;
  }

  .person-basic-info {
    flex: 1;
  }

  .person-name {
    font-size: 16px;
    font-weight: bold;
    color: #d4af37;
    margin-bottom: 2px;
  }

  .person-alias,
  .person-id {
    font-size: 10px;
    color: #666;
    font-family: 'JetBrains Mono', monospace;
    margin: 4px 0;
  }

  .person-badges {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-bottom: 12px;
  }

  .threat-badge,
  .status-badge {
    font-size: 9px;
    padding: 4px 8px;
  }

  .person-details {
    color: #888;
    margin: 12px 0;
  }

  .detail-row {
    display: flex;
    justify-content: space-between;
    margin-bottom: 6px;
    font-size: 11px;
  }

  .detail-label {
    color: #888;
  }

  .detail-value {
    color: #d4af37;
  }

  .person-description {
    font-size: 11px;
    color: #ccc;
    line-height: 1.4;
    margin: 8px 0;
  }

  .person-cases {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 8px 0;
  }

  .case-badge {
    font-size: 9px;
    padding: 4px 8px;
    border-radius: 4px;
    border: 1px solid #333;
    background: #151515;
    color: #d4af37;
  }

  /* Actions */
  .person-actions {
    display: flex;
    gap: 8px;
    justify-content: flex-end;
    margin-top: 12px;
  }

  /* Empty / loading / error */
  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 60px 20px;
    color: #666;
    text-align: center;
  }

  .empty-icon {
    font-size: 48px;
    margin-bottom: 12px;
  }

  .empty-title {
    font-size: 18px;
    color: #888;
    margin-bottom: 8px;
  }

  .empty-subtitle {
    font-size: 12px;
    color: #999;
    margin-bottom: 16px;
  }

  .error-banner {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 20px;
    background: #4a1a1a;
    border: 1px solid #ef4444;
    color: #fca5a5;
    font-size: 12px;
    margin: 15px 20px;
    border-radius: 4px;
  }

  .loading-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 60px 20px;
    color: #888;
  }

  .loading-spinner {
    width: 32px;
    height: 32px;
    border: 2px solid #3a3a3a;
    border-top: 2px solid #d4af37;
    border-radius: 50%;
    animation: spin 1s linear infinite;
    margin-bottom: 12px;
  }

  @keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }

  /* Modal styles */
  .yorha-modal {
    width: 720px;
    max-width: 95%;
    background: #2a2a2a;
    border: 2px solid #d4af37;
    color: #d4af37;
    padding: 16px;
    border-radius: 6px;
  }

  .dialog-title {
    font-size: 14px;
    font-weight: bold;
  }

  .modal-form {
    display: flex;
    flex-direction: column;
    padding: 8px 0 0 0;
  }

  .form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .form-field[style*="grid-column: 1 / -1"] {
    grid-column: 1 / -1;
  }

  .form-label {
    font-size: 11px;
    font-weight: bold;
    color: #d4af37;
    text-transform: uppercase;
  }

  .yorha-textarea {
    background: #1a1a1a;
    border: 1px solid #555;
    color: #d4af37;
    padding: 8px 10px;
    font-size: 12px;
    resize: vertical;
    font-family: inherit;
  }

  .modal-body {
    padding: 16px 0;
  }

  .analysis-section {
    margin-bottom: 16px;
  }

  .risk-score {
    color: #d4af37;
  }

  .text-red-400 {
    color: #ef4444;
  }

  .text-muted-foreground {
    color: #888;
  }

  .text-sm {
    font-size: 12px;
  }

  .text-xs {
    font-size: 10px;
  }

  .space-y-4 > * + * {
    margin-top: 16px;
  }

  .space-y-1 > * + * {
    margin-top: 4px;
  }

  .flex {
