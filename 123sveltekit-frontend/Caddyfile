}

# Health check endpoint
health.localhost:443 {
    protocols h1 h2 h3
    header Alt-Svc "h3=\":443\"; ma=86400"
    
    respond /health 200 {
        body `{
            "status": "healthy",
            "timestamp": "{time.now.unix}",
            "services": {
                "frontend": "http://localhost:5173",
                "grpc_gateway": "http://localhost:8095",
                "document_processing": "http://localhost:8096",
                "redis": "localhost:4005",
                "postgresql": "localhost:5432",
                "minio": "http://localhost:4002"
            }
        }`
        close
    }
    
    respond /metrics 200 {
        body "Legal AI Pipeline Metrics"
        close
    }
}