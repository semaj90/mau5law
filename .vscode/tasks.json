{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "🔍 Warden Inspector",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/warden-inspector-advanced.ps1",
        "-feature",
        "${input:feature}"
      ],
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "📄 Export Top Svelte Errors",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/export-svelte-errors.ps1"
      ],
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "🔧 Log Svelte-Check Errors",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/svelte-check-logger.ps1",
        "-limit",
        "1000"
      ],
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    }
  ],
  "inputs": [
    {
      "id": "feature",
      "type": "pickString",
      "description": "Choose Layer to Inspect",
      "options": [
        "API routes",
        "DB schema",
        "OCR pipeline",
        "MiniLM reranker",
        "Hybrid search",
        "Autoencoder CUDA",
        "Gemma legal summaries",
        "Evidence ingestion",
        "Timeline",
        "Neo4j citations"
      ],
      "default": "Hybrid search"
    }
  ]
}
