{
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --plugin-search-dir . --check .",
    "format": "prettier --plugin-search-dir . --write .",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "type-check": "tsc --noEmit",

    "🔌 Knowledge Base System": "",
    "knowledge:setup": "node scripts/knowledge-base-setup.mjs",
    "knowledge:test": "node scripts/test-knowledge-pipeline.mjs",
    "knowledge:ui": "open http://localhost:5173/knowledge",

    "📚 Codebase Indexing": "",
    "index:codebase": "tsx src/lib/services/codebase-indexer.ts index-code ./src",
    "index:codebase-full": "tsx src/lib/services/codebase-indexer.ts index-code ./",
    "index:errors": "tsx src/lib/services/codebase-indexer.ts index-errors",
    "search:codebase": "tsx src/lib/services/codebase-indexer.ts search \"${npm_config_query:-TypeScript error}\"",
    "search:errors": "tsx src/lib/services/codebase-indexer.ts search-errors \"${npm_config_query:-cannot find module}\"",
    "indexing:ui": "open http://localhost:5173/indexing",

    "🐍 Python RAG/KAG Middleware": "",
    "rag:api": "python scripts/phase79-rag-kag-middleware.py",
    "rag:docs": "open http://localhost:8000/docs",

    "🧠 Phase 79 Cognitive Engine": "",
    "phase79": "node scripts/phase79-cognitive-engine.mjs",
    "phase79:watch": "node --watch scripts/phase79-cognitive-engine.mjs",
    "phase79:test": "node scripts/phase79-cognitive-engine.mjs --test",

    "🔍 Debugging & Analysis": "",
    "qdrant:status": "curl http://localhost:6333/collections",
    "minio:list": "minio ls minio/",
    "db:status": "psql $DATABASE_URL -c \"SELECT version();\"",
    "services:check": "npm run qdrant:status && npm run minio:list && npm run db:status",

    "🚀 Full Stack": "",
    "dev:full": "concurrently \"npm run dev\" \"npm run rag:api\"",
    "setup:all": "npm run knowledge:setup && npm run index:codebase && npm run index:errors",
    "test:all": "npm run knowledge:test && npm run phase79:test"
  },
  "devDependencies": {
    "@qdrant/js-client-rest": "^1.8.0",
    "@types/node": "^20.0.0",
    "@sveltejs/kit": "^2.0.0",
    "svelte": "^5.0.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "dependencies": {
    "minio": "^7.0.0",
    "postgres": "^3.4.0",
    "dotenv": "^16.0.0"
  }
}
