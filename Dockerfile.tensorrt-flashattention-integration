# Create FlashAttention CUDA kernel
RUN cat > /app/tensorrt-plugins/flashattention/flash_attention_kernel.cu << 'EOF'
#include <cuda_runtime.h>
#include <cuda_fp16.h>
#include <cub/cub.cuh>
#include <device_launch_parameters.h>

// FlashAttention kernel optimized for RTX 3060 Ti (SM 8.6)
__global__ void flash_attention_q4km_kernel(
    const float* __restrict__ query,     // [batch, seq_len, num_heads, head_dim]
    const float* __restrict__ key,       // [batch, seq_len, num_heads, head_dim]
    const float* __restrict__ value,     // [batch, seq_len, num_heads, head_dim]
    float* __restrict__ output,          // [batch, seq_len, num_heads, head_dim]
    const int batch_size,
    const int seq_len,
    const int num_heads,
    const int head_dim,
    const float scale,
    bool causal = false
) {
    // Shared memory for tile-based computation
    extern __shared__ float shared_mem[];

    float* shared_q = shared_mem;
    float* shared_k = shared_q + head_dim;
    float* shared_v = shared_k + head_dim;
    float* shared_scores = shared_v + head_dim;

    const int batch_id = blockIdx.x;
    const int head_id = blockIdx.y;
    const int seq_id = blockIdx.z * blockDim.x + threadIdx.x;

    if (batch_id >= batch_size || head_id >= num_heads || seq_id >= seq_len) return;

    const int q_offset = ((batch_id * seq_len + seq_id) * num_heads + head_id) * head_dim;

    // Load query into shared memory
    if (threadIdx.x < head_dim) {
        shared_q[threadIdx.x] = query[q_offset + threadIdx.x];
    }
    __syncthreads();

    float max_score = -INFINITY;
    float sum_exp = 0.0f;

    // First pass: compute max and sum for softmax stability
    for (int k_seq = 0; k_seq < seq_len; k_seq++) {
        if (causal && k_seq > seq_id) break;

        const int k_offset = ((batch_id * seq_len + k_seq) * num_heads + head_id) * head_dim;

        // Compute attention score: Q * K^T
        float score = 0.0f;
        for (int d = 0; d < head_dim; d++) {
            score += shared_q[d] * key[k_offset + d];
        }
        score *= scale;

        max_score = fmaxf(max_score, score);
    }

    // Second pass: compute softmax denominator
    for (int k_seq = 0; k_seq < seq_len; k_seq++) {
        if (causal && k_seq > seq_id) break;

        const int k_offset = ((batch_id * seq_len + k_seq) * num_heads + head_id) * head_dim;

        float score = 0.0f;
        for (int d = 0; d < head_dim; d++) {
            score += shared_q[d] * key[k_offset + d];
        }
        score = expf((score * scale) - max_score);
        sum_exp += score;
    }

    // Third pass: compute weighted sum of values
    for (int d = 0; d < head_dim; d++) {
        float weighted_sum = 0.0f;

        for (int k_seq = 0; k_seq < seq_len; k_seq++) {
            if (causal && k_seq > seq_id) break;

            const int k_offset = ((batch_id * seq_len + k_seq) * num_heads + head_id) * head_dim;
            const int v_offset = k_offset; // Same indexing for values

            // Recompute attention score
            float score = 0.0f;
            for (int dim = 0; dim < head_dim; dim++) {
                score += shared_q[dim] * key[k_offset + dim];
            }

            float attention_weight = expf((score * scale) - max_score) / sum_exp;
            weighted_sum += attention_weight * value[v_offset + d];
        }

        output[q_offset + d] = weighted_sum;
    }
}

extern "C" {
    void launch_flash_attention_q4km(
        const float* query, const float* key, const float* value,
        float* output, int batch_size, int seq_len, int num_heads,
        int head_dim, bool causal, cudaStream_t stream
    ) {
        const float scale = 1.0f / sqrtf((float)head_dim);

        dim3 grid(batch_size, num_heads, (seq_len + 32 - 1) / 32);
        dim3 block(32);

        size_t shared_mem_size = 4 * head_dim * sizeof(float);

        flash_attention_q4km_kernel<<<grid, block, shared_mem_size, stream>>>(
            query, key, value, output, batch_size, seq_len,
            num_heads, head_dim, scale, causal
        );

        cudaStreamSynchronize(stream);
    }
}
