# Phase 72: GPU Clustering Service Dockerfile
FROM nvidia/cuda:12.1-runtime-ubuntu22.04

# Install Python and dependencies
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    python3-dev \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Install PyTorch with CUDA support
RUN pip3 install --no-cache-dir \
    torch==2.1.0+cu121 \
    torchvision==0.16.0+cu121 \
    torchaudio==2.1.0 \
    --index-url https://download.pytorch.org/whl/cu121

# Install other dependencies
RUN pip3 install --no-cache-dir \
    numpy \
    scikit-learn \
    scipy \
    pandas

# Set working directory
WORKDIR /app

# Copy GPU clustering script
COPY phase72-ast-reduction/gpu-clustering.py /app/

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python3 -c "import torch; print('CUDA' if torch.cuda.is_available() else 'CPU')" || exit 1

# Default command
CMD ["python3", "gpu-clustering.py", "--check-cuda"]