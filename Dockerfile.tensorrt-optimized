# Test script for quantized model performance
RUN cat > test_quantized_performance.sh << 'EOF'
#!/bin/bash
echo "🚀 Testing Quantized Legal AI Performance"
echo "========================================"

# Check GPU specs for RTX 3060 Ti
echo "🔍 GPU Information:"
nvidia-smi --query-gpu=name,memory.total,compute_cap --format=csv,noheader

# Verify TensorRT with quantization support
echo "🔧 TensorRT Quantization Support:"
python3 -c "
import tensorrt as trt
print(f'TensorRT version: {trt.__version__}')
builder = trt.Builder(trt.Logger())
print(f'INT8 support: {builder.platform_has_fast_int8}')
print(f'FP16 support: {builder.platform_has_fast_fp16}')
"

# Test CUDA Graph capture
echo "📊 CUDA Graph Performance Test:"
python3 -c "
import torch
import time

# Test CUDA Graph capture overhead
device = torch.device('cuda:0')
x = torch.randn(32, 512, device=device)
linear = torch.nn.Linear(512, 768).to(device)

# Warm-up
for _ in range(10):
    y = linear(x)
torch.cuda.synchronize()

# Capture graph
print('Capturing CUDA Graph...')
start = time.perf_counter()
with torch.cuda.graph(torch.cuda.CUDAGraph()) as graph:
    y = linear(x)
capture_time = time.perf_counter() - start
print(f'Graph capture: {capture_time*1000:.2f}ms')

# Replay graph (should be much faster)
start = time.perf_counter()
graph.replay()
torch.cuda.synchronize()
replay_time = time.perf_counter() - start
print(f'Graph replay: {replay_time*1000:.2f}ms')
print(f'Speedup: {capture_time/replay_time:.1f}x')
"

echo "✅ Quantized TensorRT environment ready!"
echo "🎯 Next: python3 convert_quantized_legal.py"
EOF

RUN chmod +x test_quantized_performance.sh

EXPOSE 8100

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD python3 -c "import tensorrt; print('Quantized TensorRT OK')" || exit 1

CMD ["./test_quantized_performance.sh"]