# Direct TensorRT-LLM Legal AI Container (No Ollama)
# Pure TensorRT optimization for <1ms inference

FROM nvcr.io/nvidia/tensorrt:24.09-py3

# Set environment variables for optimal performance
ENV CUDA_VISIBLE_DEVICES=0
ENV TENSORRT_VERBOSE=1
ENV CUDA_LAUNCH_BLOCKING=0
ENV TRT_LOGGER_LEVEL=WARNING
ENV PYTHONPATH=/workspace:$PYTHONPATH

# Install TensorRT-LLM directly (no Ollama)
RUN pip install --upgrade pip && \
    pip install tensorrt-llm==0.15.0 \
    fastapi[all]==0.104.1 \
    uvicorn[standard]==0.24.0 \
    torch==2.8.0+cu128 \
    transformers==4.46.0 \
    numpy==1.24.3 \
    pydantic==2.5.0 \
    && rm -rf /root/.cache/pip

# Create optimized workspace
WORKDIR /workspace
RUN mkdir -p engines models logs

# Copy direct TensorRT server (no Ollama wrapper)
COPY tensorrt-llm-direct-server.py /workspace/
COPY engines/ /workspace/engines/
COPY models/ /workspace/models/

# Optimize for RTX 3060 Ti (Ampere SM 8.6)
ENV TORCH_CUDA_ARCH_LIST="8.6"
ENV CUDA_ARCH=86

# TensorRT optimization flags
ENV TRT_ENGINE_CACHE_SIZE=1024
ENV TRT_MAX_WORKSPACE_SIZE=4294967296
ENV TRT_FP16_MODE=1
ENV TRT_INT8_MODE=0
ENV TRT_INT4_MODE=1

# CUDA Graphs optimization
ENV CUDA_GRAPH_CAPTURE=1
ENV CUDA_GRAPH_POOL_SIZE=8

# FlashAttention optimization
ENV FLASH_ATTENTION_ENABLED=1
ENV FLASH_ATTENTION_VERSION=2

# Legal AI optimization
ENV MODEL_NAME=gemma3-legal-q4km
ENV MAX_BATCH_SIZE=1
ENV MAX_INPUT_LENGTH=2048
ENV MAX_OUTPUT_LENGTH=512
ENV EMBEDDING_DIMENSION=512

# GPU memory optimization for RTX 3060 Ti (8GB)
ENV GPU_MEMORY_FRACTION=0.9
ENV PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:512

# Create engine loading script
RUN echo '#!/bin/bash\n\
echo "🚀 Direct TensorRT-LLM Legal AI Starting..."\n\
echo "🎯 Target: <1ms inference latency"\n\
echo "🔧 RTX 3060 Ti Ampere optimization"\n\
echo "⚡ CUDA Graphs + FlashAttention + INT4"\n\
\n\
# Warm up GPU\n\
nvidia-smi\n\
\n\
# Start direct TensorRT server\n\
python tensorrt-llm-direct-server.py\n\
' > /workspace/start-direct-tensorrt.sh && chmod +x /workspace/start-direct-tensorrt.sh

# Expose API port
EXPOSE 8100

# Health check for direct TensorRT engine
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8100/health || exit 1

# Start direct TensorRT server (no Ollama)
CMD ["/workspace/start-direct-tensorrt.sh"]