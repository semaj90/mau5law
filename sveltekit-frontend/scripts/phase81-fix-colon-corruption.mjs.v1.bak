// scripts/phase81-fix-colon-corruption.mjs
import { spawnSync } from "node:child_process";
import fs from "node:fs";
import os from "node:os";
import path from "node:path";

const norm = (p) => p.replaceAll("\\", "/");
const toAbs = (p) => (path.isAbsolute(p) ? p : path.resolve(process.cwd(), p));

function parseArgv(argv) {
  const out = {};
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (!a.startsWith("--")) continue;
    const [k, vEq] = a.slice(2).split("=", 2);
    const next = argv[i + 1];
    if (vEq !== undefined) out[k] = vEq;
    else if (next && !next.startsWith("--")) { out[k] = next; i++; }
    else out[k] = true;
  }
  return out;
}

function resolveExistingPath(p) {
  const abs = toAbs(p);
  if (!fs.existsSync(abs)) throw new Error(`Path not found: ${abs}`);
  return abs;
}

function walkDir(dirAbs) {
  const out = [];
  const stack = [dirAbs];
  while (stack.length) {
    const cur = stack.pop();
    const entries = fs.readdirSync(cur, { withFileTypes: true });
    for (const e of entries) {
      const full = path.join(cur, e.name);
      const rel = norm(path.relative(process.cwd(), full));
      if (
        rel.includes("node_modules/") ||
        rel.startsWith(".svelte-kit/") ||
        rel.startsWith("build/") ||
        rel.startsWith("dist/") ||
        rel.startsWith(".git/")
      ) continue;

      if (e.isDirectory()) stack.push(full);
      else if (e.isFile() && (full.endsWith(".ts") || full.endsWith(".tsx"))) out.push(full);
    }
  }
  return out;
}

function writeDiffPatch(fileAbs, before, after, outDir) {
  const patchDir = path.join(outDir || "reports", "patches");
  if (!fs.existsSync(patchDir)) fs.mkdirSync(patchDir, { recursive: true });

  const safeName = norm(path.relative(process.cwd(), fileAbs))
    .replaceAll("/", "__")
    .replaceAll(":", "_");

  const tmpA = path.join(os.tmpdir(), `${safeName}.before.ts`);
  const tmpB = path.join(os.tmpdir(), `${safeName}.after.ts`);

  fs.writeFileSync(tmpA, before, "utf8");
  fs.writeFileSync(tmpB, after, "utf8");

  const r = spawnSync("git", ["diff", "--no-index", "--", tmpA, tmpB], {
    encoding: "utf8",
    shell: true,
  });

  const diffText = (r.stdout || "") + (r.stderr || "");
  fs.writeFileSync(path.join(patchDir, `${safeName}.diff`), diffText, "utf8");
}

// -------------------------
// Safety: delimiter balance
// -------------------------
function countUnescapedBackticks(s) {
  // crude but effective: ignore escaped \`
  let c = 0;
  for (let i = 0; i < s.length; i++) {
    if (s[i] === "`" && s[i - 1] !== "\\") c++;
  }
  return c;
}
function balanceScore(s) {
  const open = (ch) => (s.match(new RegExp(`\\${ch}`, "g")) ?? []).length;
  return {
    paren: open("(") - open(")"),
    brace: open("{") - open("}"),
    bracket: open("[") - open("]"),
    backtickParity: countUnescapedBackticks(s) % 2, // 0=balanced-ish, 1=odd
  };
}
function isWorseBalance(before, after) {
  const b = balanceScore(before);
  const a = balanceScore(after);
  // “worse” = magnitude increased in any dimension
  const worse =
    Math.abs(a.paren) > Math.abs(b.paren) ||
    Math.abs(a.brace) > Math.abs(b.brace) ||
    Math.abs(a.bracket) > Math.abs(b.bracket) ||
    a.backtickParity > b.backtickParity;
  return { worse, before: b, after: a };
}

// -------------------------
// Colon corruption fixers
// -------------------------

function countChar(s, ch) {
  return (s.match(new RegExp(`\\${ch}`, "g")) ?? []).length;
}

// 1) Type-alias RHS unions: type X = GPUDevice: undefined;
function fixTypeAliasColonUnion(line, stats) {
  const before = line;
  if (!/^\s*type\s+\w+\s*=/.test(line)) return line;
  if (!line.includes(":")) return line;

  // avoid object type literals: type X = { a: string: number }
  // (those are ambiguous and should be handled by delimiter-fixer / real AST later)
  if (line.includes("{")) return line;

  // only rewrite when RHS contains ": undefined|null|never|void" OR "A: B" with no commas
  const rhs = line.split("=").slice(1).join("=");
  if (/\s*:\s*(undefined|null|never|void)\b/.test(rhs) ||
      (!rhs.includes(",") && /\b[A-Za-z_$][\w$]*\b\s*:\s*\b[A-Za-z_$][\w$]*\b/.test(rhs))) {
    const out = line.replace(/\s*:\s*/g, " | ");
    if (out !== before) stats["type-alias-colon-union"] = (stats["type-alias-colon-union"] ?? 0) + 1;
    return out;
  }
  return before;
}

// 2) Generic unions: Promise<Float32Array: null> -> Promise<Float32Array | null>
function fixGenericColonUnion(line, stats) {
  const before = line;
  const out = line.replace(/<([^>\n]*?)\s*:\s*(null|undefined|never|void)\b/g, (_m, lhs, rhs) => {
    stats["generic-colon-union"] = (stats["generic-colon-union"] ?? 0) + 1;
    return `<${lhs} | ${rhs}`;
  });
  return out !== before ? out : before;
}

// 3) Param “name, type” -> “name: type” (primitive-ish only)
function fixParamCommaType(line, stats) {
  const before = line;

  // Only operate inside (...) groups on the same line.
  const out = line.replace(/\(([^()\n]*)\)/g, (full, inner) => {
    let changed = false;
    let s = inner;

    s = s.replace(
      /(\b[A-Za-z_$][\w$]*\b)\s*,\s*(string|number|boolean|any|unknown|object)\b/g,
      (_m, name, t) => { changed = true; return `${name}: ${t}`; }
    );

    if (!changed) return full;
    stats["param-name-comma-type"] = (stats["param-name-comma-type"] ?? 0) + 1;
    return `(${s})`;
  });

  return out !== before ? out : before;
}

// 4) Signature tail: "), any: Promise<...>" -> ", options: any): Promise<...>"
function fixSignatureTailParam(line, stats) {
  const before = line;

  // Must look like a real signature line and contain ") , <type> :"
  if (!/\)\s*,\s*(any|unknown|string|number|boolean)\s*:/.test(line)) return line;
  if (!/(async\s+)?[A-Za-z_$][\w$]*\s*\(|private|public|protected|function/.test(line)) return line;

  const out = line.replace(/\)\s*,\s*(any|unknown|string|number|boolean)\s*:/g, (_m, t) => {
    stats["signature-tail-param"] = (stats["signature-tail-param"] ?? 0) + 1;
    return `, options: ${t}):`;
  });

  return out !== before ? out : before;
}

// 5) Object colon chains: key: val: key2 -> key: val, key2
function fixObjectColonChains(line, stats) {
  const before = line;
  const colonCount = countChar(line, ":");
  if (colonCount < 2) return line;
  if (/^\s*(type|interface|export\s+interface)\b/.test(line)) return line;
  if (line.includes("http://") || line.includes("https://")) return line;

  let out = line;
  // Aggressive chain fixer: key: val: key2 -> key: val, key2
  // val cannot contain ? (ternary), { (object), : (nested), ) (func end), , (comma), ; (semi), ( (func start), or ] (array/index end)
  for (let i = 0; i < 10; i++) {
    const next = out.replace(
      /(\b[A-Za-z_$][\w$]*\b)\s*:\s*([^:?{\n),;(\]]+?)\s*:\s*(\b[A-Za-z_$][\w$]*\b)/g,
      (_m, k1, v1, k2) => {
        stats["object-colon-chain"] = (stats["object-colon-chain"] ?? 0) + 1;
        return `${k1}: ${v1.trim()}, ${k2}`;
      }
    );
    if (next === out) break;
    out = next;
  }

  return out !== before ? out : before;
}

function runFixers(text, statsOut) {
  const stats = statsOut ?? {};
  const lines = text.split(/\r?\n/);

  const out = lines.map((line) => {
    let s = line;
    s = fixGenericColonUnion(s, stats);
    s = fixTypeAliasColonUnion(s, stats);
    s = fixSignatureTailParam(s, stats);
    s = fixParamCommaType(s, stats);
    s = fixObjectColonChains(s, stats);
    return s;
  }).join("\n");

  return { text: out, stats };
}

// -------------------------
// Main
// -------------------------
const args = parseArgv(process.argv.slice(2));
const dryRun = !!args["dry-run"] || !!args.dryrun;
const debug = !!args.debug;

let files = [];
if (args.file) files = [resolveExistingPath(args.file)];
else if (args.dir) files = walkDir(resolveExistingPath(args.dir));
else if (args.list) {
  const listPath = resolveExistingPath(args.list);
  const content = fs.readFileSync(listPath, "utf8");
  files = content
    .split(/\r?\n/)
    .map(l => l.trim())
    .filter(l => l && !l.startsWith("#"))
    .map(l => toAbs(l));
}
else {
  console.error("Usage: node scripts/phase81-fix-colon-corruption.mjs --file=... [--dry-run] [--debug]  OR  --dir=... OR --list=...");
  process.exit(2);
}

fs.mkdirSync("reports", { recursive: true });

const outDir = args.out ? toAbs(args.out) : "reports";
if (args.out && !fs.existsSync(outDir)) fs.mkdirSync(outDir, { recursive: true });

fs.writeFileSync(
  path.join(outDir, "phase81-fix-colon-files-to-process.txt"),
  files.map((f) => norm(f)).join("\n") + "\n",
  "utf8"
);

let totalFixes = 0;
let filesModified = 0;
let filesRevertedForBalance = 0;
const perFile = [];

for (const f of files) {
  const before = fs.readFileSync(f, "utf8");
  const stats = {};
  const { text: afterRaw } = runFixers(before, stats);

  const fixes = Object.values(stats).reduce((a, b) => a + b, 0);
  const changed = afterRaw !== before;

  let after = afterRaw;
  let reverted = false;

  if (changed) {
    const bal = isWorseBalance(before, afterRaw);
    if (bal.worse) {
      reverted = true;
      after = before;
      filesRevertedForBalance++;
      if (debug) {
        console.log(`  ⚠️  REVERT(balance): ${norm(path.relative(process.cwd(), f))}`, bal);
      }
    }
  }

  if (!reverted) totalFixes += fixes;
  if (changed && !reverted) filesModified++;

  perFile.push({
    file: norm(path.relative(process.cwd(), f)),
    changed: changed && !reverted,
    revertedForBalance: reverted,
    fixes: reverted ? 0 : fixes,
    breakdown: reverted ? {} : stats,
  });

  if (changed && !reverted) {
    console.log(`  ✅ ${norm(path.relative(process.cwd(), f))}: ${fixes} fixes`);
    writeDiffPatch(f, before, after, outDir);
    if (!dryRun) fs.writeFileSync(f, after, "utf8");
  } else {
    console.log(`  · ${norm(path.relative(process.cwd(), f))}: 0 fixes`);
  }
}

const summary = {
  dryRun,
  filesProcessed: files.length,
  filesModified,
  filesRevertedForBalance,
  totalFixes,
  topFiles: perFile.sort((a, b) => b.fixes - a.fixes).slice(0, 50),
};

fs.writeFileSync(path.join(outDir, "phase81-fix-colon-summary.json"), JSON.stringify(summary, null, 2), "utf8");

console.log("================================================================================");
console.log(`📊 Summary: processed=${files.length} modified=${filesModified} reverted(balance)=${filesRevertedForBalance} totalFixes=${totalFixes}`);
console.log("📁 Wrote:");
console.log(`   ${path.join(outDir, "phase81-fix-colon-files-to-process.txt")}`);
console.log(`   ${path.join(outDir, "phase81-fix-colon-summary.json")}`);
console.log(`   ${path.join(outDir, "patches/*.diff")} (for modified files)`);
console.log("================================================================================");
process.exit(0);
