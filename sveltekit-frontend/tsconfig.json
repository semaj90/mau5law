{
  "extends": "./.svelte-kit/tsconfig.json",
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "allowJs": true,
    "checkJs": true,
    "verbatimModuleSyntax": true,
    "sourceMap": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": false,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "lib": ["esnext", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "isolatedModules": true,
    "types": ["svelte", "vite/client", "@sveltejs/kit", "@webgpu/types", "node"]
  },
  "include": ["src/**/*.d.ts", "src/**/*.ts", "src/**/*.js", "src/**/*.svelte"],
  "exclude": [
    "node_modules",
    "build",
    ".svelte-kit",
    "dist",
    "archived-components/**",
    ".svelte-check-tmp/**",
    "../.rag-metrics/**",
    "src/tests/**",
    "src/stories/**",
    "src/lib/experimental/**",
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/node_modules/**",
    "src/lib/server/thread-safe-postgres.ts",
    "src/lib/server/gpu-thread-coordinator.ts",
    "src/lib/services/gpu-cache-orchestrator.ts",
    "src/lib/services/webgpu-texture-streaming.ts",
    "src/lib/services/chr-rom-mipmap-integration.ts",
    "src/lib/types/drizzle-enhanced.d.ts",
    "src/proto/**",
    "src/grpc/**",
    "src/flatbuf/**",
    "src/wasm/**",
    "src/workers/**",
    "**/*.worker.ts",
    "**/*.sw.ts",
    "**/service-worker.ts"
  ]
}
