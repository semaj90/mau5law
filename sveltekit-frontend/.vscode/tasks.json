{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "TypeScript Check - Optimized",
      "type": "shell",
      "command": "npx",
      "args": ["tsc", "--noEmit", "--skipLibCheck"],
      "group": "test",
      "options": {
        "env": {
          "NODE_OPTIONS": "--max-old-space-size=3072"
        }
      },
      "problemMatcher": ["$tsc"],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "new"
      }
    },
    {
      "label": "Svelte Check - Optimized",
      "type": "shell",
      "command": "npx",
      "args": ["svelte-check", "--skipLibCheck"],
      "group": "test",
      "options": {
        "env": {
          "NODE_OPTIONS": "--max-old-space-size=3072"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "new"
      }
    },
    {
      "label": "Dev Server - Optimized",
      "type": "shell",
      "command": "npm",
      "args": ["run", "dev"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "isBackground": true,
      "options": {
        "env": {
          "NODE_OPTIONS": "--max-old-space-size=3072"
        }
      },
      "problemMatcher": ["$tsc"],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "new"
      }
    }
  ]
}