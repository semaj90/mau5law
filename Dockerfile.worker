FROM node:20-alpine

WORKDIR /app

# Install dependencies
RUN apk add --no-cache \
    python3 \
    make \
    g++ \
    cairo-dev \
    jpeg-dev \
    pango-dev \
    giflib-dev

# Copy package files
COPY package*.json ./
RUN npm ci --only=production

# Copy source code
COPY . .

# Build TypeScript
RUN npm run build

# Set worker type from build arg
ARG WORKER_TYPE=summary-generation
ENV WORKER_TYPE=${WORKER_TYPE}

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD node -e "require('http').get('http://localhost:3001/health', (r) => {if (r.statusCode !== 200) throw new Error(r.statusCode)})"

# Start worker
CMD ["node", "--loader", "ts-node/esm", "src/lib/server/workers/${WORKER_TYPE}.worker.ts"]
