# TensorRT-LLM + Ollama Integration Container
# Mounts Ollama models and converts to optimized .plan engines

FROM nvcr.io/nvidia/tensorrt:24.09-py3

# Install PyTorch with CUDA support first (compatible versions)
RUN pip install --upgrade pip && \
    pip install torch==2.4.1 torchvision torchaudio --index-url https://download.pytorch.org/whl/cu121

# Install other dependencies with compatible versions
RUN pip install \
    fastapi[all]==0.104.1 \
    uvicorn[standard]==0.24.0 \
    transformers==4.44.0 \
    numpy==1.24.3 \
    pydantic==2.5.0 \
    requests==2.31.0 \
    accelerate==0.33.0 \
    tokenizers==0.19.1 \
    sentencepiece==0.2.0 \
    protobuf==4.25.0 \
    && rm -rf /root/.cache/pip

# Try to install TensorRT-LLM from NVIDIA PyPI (may not be available)
RUN pip install tensorrt-llm --extra-index-url https://pypi.nvidia.com || \
    echo "TensorRT-LLM not available via pip, using base container TensorRT"

# Install Ollama client for model access
RUN curl -fsSL https://ollama.com/install.sh | sh

# Set working directory
WORKDIR /workspace

# Create directories for mounted volumes
RUN mkdir -p /workspace/engines \
             /workspace/models \
             /workspace/ollama-models \
             /workspace/converted-models \
             /workspace/logs

# Copy our TensorRT server and conversion scripts
COPY tensorrt-llm-direct-server.py /workspace/
COPY build-tensorrt-engine-direct.py /workspace/
COPY convert-ollama-to-tensorrt.py /workspace/

# Environment variables for optimization
ENV CUDA_VISIBLE_DEVICES=0
ENV TENSORRT_VERBOSE=1
ENV CUDA_LAUNCH_BLOCKING=0
ENV TRT_LOGGER_LEVEL=WARNING
ENV PYTHONPATH=/workspace:$PYTHONPATH

# RTX 3060 Ti optimization
ENV TORCH_CUDA_ARCH_LIST="8.6"
ENV CUDA_ARCH=86
ENV TRT_ENGINE_CACHE_SIZE=1024
ENV TRT_MAX_WORKSPACE_SIZE=4294967296
ENV TRT_FP16_MODE=1
ENV TRT_INT4_MODE=1

# CUDA Graphs optimization
ENV CUDA_GRAPH_CAPTURE=1
ENV CUDA_GRAPH_POOL_SIZE=8
ENV FLASH_ATTENTION_ENABLED=1

# Ollama configuration
ENV OLLAMA_HOST=host.docker.internal:11434
ENV OLLAMA_MODELS_PATH=/workspace/ollama-models

# Create startup script
RUN echo '#!/bin/bash\n\
echo "🚀 TensorRT-LLM + Ollama Integration Container"\n\
echo "🎯 Converting Ollama models to optimized .plan engines"\n\
echo "⚡ Target: <1ms inference with knowledge distillation"\n\
\n\
# Connect to host Ollama instance\n\
export OLLAMA_HOST=host.docker.internal:11434\n\
\n\
# Test Ollama connection\n\
echo "🔗 Testing Ollama connection..."\n\
curl -f http://host.docker.internal:11434/api/tags || echo "⚠️  Ollama not accessible"\n\
\n\
# Convert models to TensorRT engines\n\
echo "🔄 Converting Ollama models to TensorRT engines..."\n\
python convert-ollama-to-tensorrt.py\n\
\n\
# Start TensorRT server\n\
echo "🚀 Starting TensorRT-LLM server..."\n\
python tensorrt-llm-direct-server.py\n\
' > /workspace/start-tensorrt-ollama.sh && chmod +x /workspace/start-tensorrt-ollama.sh

# Expose TensorRT server port
EXPOSE 8100

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 \
    CMD curl -f http://localhost:8100/health || exit 1

# Start the integrated server
CMD ["/workspace/start-tensorrt-ollama.sh"]