# Caddy Configuration for SvelteKit 2 Local Development
# Fixed for local Windows development without Docker

# Global options
{
    admin off
    auto_https off
    log {
        level INFO
    }
}

# Main application proxy to local SvelteKit
:8080 {
    # Enable CORS for API endpoints
    header {
        Access-Control-Allow-Origin *
        Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
        Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With"
        -Server
    }

    # Handle preflight OPTIONS requests
    @cors_preflight method OPTIONS
    respond @cors_preflight 200

    # Load balance across local SvelteKit instances
    reverse_proxy localhost:5173 localhost:5174 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
        lb_policy round_robin
        health_uri /
        health_interval 30s
        health_timeout 5s
        fail_duration 30s
    }

    # Handle WebSocket connections for Vite HMR
    @websocket {
        header Connection *Upgrade*
        header Upgrade websocket
    }
    reverse_proxy @websocket localhost:5173 localhost:5174 {
        lb_policy least_conn
    }

    # Logging
    log {
        output file logs/caddy-access.log {
            roll_size 10mb
            roll_keep 5
        }
        format console
        level INFO
    }
}

# Development port access (direct access to SvelteKit instances)
:5170 {
    reverse_proxy localhost:5173 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
    }
}

:5171 {
    reverse_proxy localhost:5174 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
    }
}

# API Gateway for local services
:8085 {
    # Enable CORS
    header {
        Access-Control-Allow-Origin *
        Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
        Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With"
    }

    # Handle preflight OPTIONS
    @cors_preflight method OPTIONS
    respond @cors_preflight 200

    # TensorRT Bridge (our new optimized bridge)
    handle_path /api/tensorrt/* {
        reverse_proxy localhost:8087 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
        }
    }

    # Original TensorRT Bridge
    handle_path /api/ai/* {
        reverse_proxy localhost:8086 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
        }
    }

    # Ollama API
    handle_path /api/ollama/* {
        reverse_proxy localhost:11434 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
        }
    }

    # PostgreSQL proxy (if needed)
    handle_path /api/db/* {
        reverse_proxy localhost:5432 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
        }
    }

    # Redis proxy (if needed)
    handle_path /api/redis/* {
        reverse_proxy localhost:6379 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
        }
    }

    # Default response for API gateway
    respond "API Gateway - Legal AI Platform" 200

    log {
        output file logs/caddy-api.log {
            roll_size 10mb
            roll_keep 5
        }
        format console
        level INFO
    }
}

