# Optimized Caddy configuration for Legal AI stack
# Supports HTTP/3 QUIC, gRPC, WebSocket streaming, and static optimization

{
	# Enable HTTP/3 support
	servers {
		protocols h1 h2 h3
	}

	# Optimize for legal AI workloads
	order file_server before reverse_proxy

	# Enable experimental features
	experimental_http3
}

# Main legal AI application
localhost:3000 {
	# Enable HTTP/3 QUIC
	protocols h1 h2 h3

	# Security headers for legal applications
	header {
		# CORS for legal AI APIs
		Access-Control-Allow-Origin "*"
		Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
		Access-Control-Allow-Headers "Content-Type, Authorization, X-Client-ID"

		# Security for legal documents
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Content-Security-Policy "default-src 'self'; connect-src 'self' ws: wss: http: https:; script-src 'self' 'unsafe-inline' 'unsafe-eval'"
	}

	# SvelteKit frontend (optimized static serving)
	route /* {
		# Try static files first (optimized with compression)
		file_server {
			root /app/build
			precompressed gzip br
		}

		# Fallback to SvelteKit adapter
		reverse_proxy localhost:5173 {
			header_up Host {http.request.host}
			header_up X-Real-IP {http.request.remote.host}
			header_up X-Forwarded-For {http.request.remote.host}
			header_up X-Forwarded-Proto {http.request.scheme}
		}
	}

	# API routes optimization
	route /api/* {
		# Enable compression for JSON responses
		encode gzip br

		# Route to optimized Go microservice
		reverse_proxy localhost:8105 {
			# HTTP/2 to backend
			transport http {
				versions h2c 2
			}

			# Optimize for legal AI workloads
			flush_interval -1
			buffer_requests

			# Health check
			health_uri /health
			health_interval 10s
			health_timeout 5s
		}
	}

	# TensorRT-LLM direct access (HTTP/3 QUIC)
	route /tensorrt/* {
		uri strip_prefix /tensorrt
		reverse_proxy localhost:8100 {
			# QUIC/HTTP3 transport
			transport http {
				versions h3 h2 h1
			}

			# Optimize for inference workloads
			flush_interval 1ms
			header_up X-Forwarded-Proto {http.request.scheme}
		}
	}

	# gRPC microservices
	route /grpc/* {
		reverse_proxy h2c://localhost:8104 {
			# gRPC-specific headers
			header_up X-Forwarded-Proto {http.request.scheme}

			# No buffering for streaming
			flush_interval -1
			buffer_requests off
		}
	}

	# QUIC/HTTP3 direct endpoint
	route /quic/* {
		uri strip_prefix /quic
		reverse_proxy https://localhost:8103 {
			transport http {
				versions h3
			}

			# Ultra-low latency settings
			flush_interval 0
			buffer_requests off
			buffer_responses off
		}
	}

	# WebSocket for real-time legal updates
	route /ws/* {
		reverse_proxy localhost:8106 {
			# WebSocket specific
			header_up Connection {http.request.header.Connection}
			header_up Upgrade {http.request.header.Upgrade}
			header_up Sec-WebSocket-Key {http.request.header.Sec-WebSocket-Key}
			header_up Sec-WebSocket-Version {http.request.header.Sec-WebSocket-Version}
		}
	}

	# Static legal document serving (optimized)
	route /documents/* {
		file_server {
			root /legal-documents
			browse
			precompressed gzip br

			# Optimize for large legal documents
			@large_files {
				path *.pdf *.docx *.zip
			}
			header @large_files {
				Cache-Control "public, max-age=86400"
				X-Accel-Buffering "no"
			}
		}
	}

	# Performance monitoring
	route /metrics {
		reverse_proxy localhost:9090 {
			# Prometheus metrics
			header_up Host {http.request.host}
		}
	}

	# Request logging for legal compliance
	log {
		output file /var/log/caddy/legal-ai-access.log {
			roll_size 100mb
			roll_keep 10
			roll_keep_for 720h
		}
		format json {
			time_format "2006-01-02T15:04:05.000Z07:00"
			message_key "message"
			level_key "level"
			time_key "timestamp"

			# Legal compliance fields
			request_headers >X-Client-ID
			response_headers <X-Inference-Time
			custom_fields {
				legal_compliance "true"
				data_classification "confidential"
			}
		}
	}
}

# Load balancer for multiple instances
legal-ai-cluster.local:3000 {
	# Load balance across multiple instances
	reverse_proxy {
		# Primary instance (TensorRT-LLM optimized)
		to localhost:8105

		# Backup instances
		to localhost:8205
		to localhost:8305

		# Load balancing strategy
		lb_policy round_robin

		# Health checks
		health_uri /health
		health_interval 10s
		health_timeout 3s
		health_status 200

		# Failover settings
		fail_duration 30s
		max_fails 3
		unhealthy_latency 2s

		# Optimize for legal AI
		header_up X-Cluster-Node {upstream}
		header_up X-Load-Balancer "caddy-legal-ai"
	}

	# Enable metrics collection
	metrics /internal/metrics
}

# Development environment
:5173 {
	# Direct pass-through to SvelteKit dev server
	reverse_proxy localhost:5173 {
		# WebSocket support for HMR
		header_up Connection {http.request.header.Connection}
		header_up Upgrade {http.request.header.Upgrade}

		# Development-specific headers
		header_down X-Development "true"
	}
}

# Internal health checks and admin
:2019 {
	# Caddy admin API
	route /config/* {
		admin
	}

	# Custom health check for the entire stack
	route /health/stack {
		respond `{
			"status": "healthy",
			"components": {
				"caddy": "ok",
				"sveltekit": "ok",
				"tensorrt_llm": "ok",
				"cuda_graphs": "ok",
				"quic": "ok",
				"grpc": "ok"
			},
			"timestamp": "{time.now.unix}",
			"optimization_stack": "HTTP3+QUIC+gRPC+TensorRT-LLM+CUDA"
		}` 200 {
			header Content-Type application/json
		}
	}
}