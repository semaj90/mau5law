# Caddy Configuration for QUIC/HTTP3 with 384-Dimension Vector Stack
# Purpose: Enable HTTP/3 for high-performance concurrent requests
# Date: 2025-10-17

{
	# Global options
	admin off
	auto_https off

	# Enable HTTP/3 (QUIC)
	servers {
		protocol {
			experimental_http3
		}
	}
}

# ============================================================================
# Main SvelteKit Application (HTTP/3 enabled)
# ============================================================================

:5173 {
	# Enable HTTP/3
	protocol h1 h2 h3

	# QUIC-specific settings
	# QUIC uses UDP, not TCP
	bind 0.0.0.0

	# Reverse proxy to SvelteKit dev server
	reverse_proxy localhost:5174 {
		# Connection pooling for QUIC
		transport http {
			# Keep-alive for connection reuse
			keepalive 30s
			keepalive_idle_conns 10
			max_idle_conns 100
		}

		# Health check
		health_uri /api/health
		health_interval 30s
		health_timeout 10s

		# Headers
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
	}

	# CORS for API endpoints
	@api {
		path /api/*
	}
	handle @api {
		header Access-Control-Allow-Origin *
		header Access-Control-Allow-Methods "GET, POST, PUT, DELETE, PATCH, OPTIONS"
		header Access-Control-Allow-Headers "Content-Type, Authorization"
		reverse_proxy localhost:5174
	}

	# Cache static assets
	@static {
		path *.js *.css *.woff *.woff2 *.png *.jpg *.svg
	}
	handle @static {
		header Cache-Control "public, max-age=31536000, immutable"
		reverse_proxy localhost:5174
	}

	# Logging
	log {
		output file /var/log/caddy/sveltekit.log
		format json
		level INFO
	}
}

# ============================================================================
# Qdrant Vector Search (HTTP/3 enabled)
# ============================================================================

:6333 {
	protocol h1 h2 h3
	bind 0.0.0.0

	reverse_proxy localhost:6334 {
		transport http {
			keepalive 30s
			keepalive_idle_conns 10
		}

		# Qdrant health check
		health_uri /healthz
		health_interval 30s
		health_timeout 5s
	}

	# CORS for Qdrant API
	header Access-Control-Allow-Origin *
	header Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
	header Access-Control-Allow-Headers "Content-Type, Authorization"

	log {
		output file /var/log/caddy/qdrant.log
		format json
	}
}

# ============================================================================
# Redis (TCP only, no HTTP/3 needed)
# ============================================================================

# Note: Redis uses TCP protocol directly, not HTTP
# No Caddy proxy needed - applications connect directly to :6379

# ============================================================================
# RabbitMQ Management UI (Optional HTTP/3)
# ============================================================================

:15672 {
	protocol h1 h2 h3
	bind 0.0.0.0

	reverse_proxy localhost:15673 {
		transport http {
			keepalive 30s
		}

		health_uri /api/health/checks/alarms
		health_interval 30s
		health_timeout 10s
	}

	log {
		output file /var/log/caddy/rabbitmq.log
	}
}

# ============================================================================
# Neo4j Browser (Optional HTTP/3)
# ============================================================================

:7474 {
	protocol h1 h2 h3
	bind 0.0.0.0

	reverse_proxy localhost:7475 {
		transport http {
			keepalive 30s
		}
	}

	log {
		output file /var/log/caddy/neo4j.log
	}
}

# ============================================================================
# MinIO Console (Optional HTTP/3)
# ============================================================================

:9001 {
	protocol h1 h2 h3
	bind 0.0.0.0

	reverse_proxy localhost:9002 {
		transport http {
			keepalive 30s
		}

		health_uri /minio/health/live
		health_interval 30s
		health_timeout 5s
	}

	log {
		output file /var/log/caddy/minio.log
	}
}

