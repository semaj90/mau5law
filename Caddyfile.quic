# Caddy Configuration with QUIC/HTTP3 Support
# Legal AI Platform - SvelteKit 2 + Go Bridge + TensorRT Services
# Optimized for Docker Desktop via WSL2

# Global options with QUIC/HTTP3 experimental support
{
	admin off
	auto_https off
	log {
		level INFO
	}

	# Enable experimental HTTP/3 support
	servers {
		protocols h1 h2 h3
	}
}

# Main application proxy with QUIC/HTTP3 (Port 8080)
:8080 {
	# Enhanced CORS for QUIC/HTTP3
	header {
		Access-Control-Allow-Origin *
		Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS, HEAD, PATCH"
		Access-Control-Allow-Headers "Accept, Authorization, Content-Type, X-CSRF-Token, X-Requested-With, Origin, User-Agent, DNT, Cache-Control, X-Mx-ReqToken, Keep-Alive, If-Modified-Since"
		Access-Control-Expose-Headers "Content-Length, Access-Control-Allow-Origin, Access-Control-Allow-Headers, Cache-Control, Content-Language, Content-Type"
		Access-Control-Max-Age "7200"

		# QUIC/HTTP3 advertisement
		Alt-Svc "h3=\":443\"; ma=2592000"
		Vary "Origin, Access-Control-Request-Method, Access-Control-Request-Headers"

		# Security headers
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"

		# Remove server identification
		-Server
	}

	# Handle preflight OPTIONS requests for QUIC
	@cors_preflight method OPTIONS
	handle @cors_preflight {
		header Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS, HEAD, PATCH"
		header Access-Control-Allow-Headers "Accept, Authorization, Content-Type, X-CSRF-Token, X-Requested-With, Origin, User-Agent, DNT, Cache-Control, X-Mx-ReqToken, Keep-Alive, If-Modified-Since"
		respond 200
	}

	# Load balance across SvelteKit instances with enhanced health checks
	reverse_proxy sveltekit-1:5173 sveltekit-2:5174 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Port {server_port}

		# Enhanced load balancing for QUIC
		lb_policy round_robin
		lb_try_duration 1s
		lb_try_interval 250ms

		# Health checks optimized for container environment
		health_uri /
		health_interval 15s
		health_timeout 3s
		health_status 2xx
		fail_duration 15s
		max_fails 3

		# Connection pooling for performance
		transport http {
			keepalive 30s
			keepalive_idle_conns 32
		}
	}

	# Handle WebSocket connections for Vite HMR with QUIC fallback
	@websocket {
		header Connection *Upgrade*
		header Upgrade websocket
	}
	reverse_proxy @websocket sveltekit-1:5173 sveltekit-2:5174 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		lb_policy least_conn
	}

	# Enhanced logging for QUIC debugging
	log {
		output file /var/log/caddy/access-quic.log {
			roll_size 50mb
			roll_keep 10
		}
		format json {
			time_format "iso8601"
			message_key "msg"
		}
		level INFO
	}
}

# API Gateway with QUIC/HTTP3 Support (Port 8090)
:8090 {
	# Enhanced CORS for API gateway
	header {
		Access-Control-Allow-Origin *
		Access-Control-Allow-Credentials true
		Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS, HEAD, PATCH"
		Access-Control-Allow-Headers "Accept, Authorization, Content-Type, X-CSRF-Token, X-Requested-With, Origin, User-Agent, DNT, Cache-Control, X-Mx-ReqToken, Keep-Alive, If-Modified-Since"
		Access-Control-Expose-Headers "Content-Length, Access-Control-Allow-Origin, Access-Control-Allow-Headers, Cache-Control, Content-Language, Content-Type, X-Response-Time"
		Access-Control-Max-Age "7200"

		# QUIC/HTTP3 advertisement for API
		Alt-Svc "h3=\":443\"; ma=2592000"
		Vary "Origin, Access-Control-Request-Method, Access-Control-Request-Headers"
	}

	# Handle preflight OPTIONS
	@cors_preflight method OPTIONS
	handle @cors_preflight {
		respond 200
	}

	# Enhanced TensorRT Bridge (QUIC-optimized Go bridge)
	handle_path /api/tensorrt/* {
		reverse_proxy tensorrt-bridge:8087 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}

			# Performance optimizations for AI workloads
			transport http {
				read_timeout 30s
				write_timeout 30s
				dial_timeout 5s
				keepalive 60s
			}

			# Health check for AI service
			health_uri /health
			health_interval 10s
			health_timeout 5s
		}
	}

	# Direct TensorRT Legal Model Access
	handle_path /api/tensorrt-legal/* {
		reverse_proxy tensorrt-legal:8090 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}

			transport http {
				read_timeout 60s
				write_timeout 60s
			}
		}
	}

	# Direct TensorRT 270M Model Access
	handle_path /api/tensorrt-270m/* {
		reverse_proxy tensorrt-270m:8091 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}

			transport http {
				read_timeout 30s
				write_timeout 30s
			}
		}
	}

	# Ollama Fallback API
	handle_path /api/ollama/* {
		reverse_proxy ollama:11434 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}

			transport http {
				read_timeout 120s
				write_timeout 120s
			}
		}
	}

	# PostgreSQL proxy (for direct DB access if needed)
	handle_path /api/db/* {
		reverse_proxy postgres:5432 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
		}
	}

	# Redis proxy (for cache management)
	handle_path /api/redis/* {
		reverse_proxy redis:6379 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
		}
	}

	# Qdrant Vector Database
	handle_path /api/vectors/* {
		reverse_proxy qdrant:6333 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
		}
	}

	# Default API Gateway response
	handle {
		header Content-Type application/json
		respond "API Gateway - Legal AI Platform with QUIC/HTTP3 Support" 200
	}

	# API logging with enhanced details
	log {
		output file /var/log/caddy/api-quic.log {
			roll_size 100mb
			roll_keep 15
		}
		format json {
			time_format "iso8601"
			message_key "msg"
		}
		level INFO
	}
}

# Direct development access with QUIC (Port 5170, 5171)
:5170 {
	reverse_proxy sveltekit-1:5173 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}

		# QUIC headers for development
		header Alt-Svc "h3=\":443\"; ma=2592000"
	}
}

:5171 {
	reverse_proxy sveltekit-2:5174 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}

		# QUIC headers for development
		header Alt-Svc "h3=\":443\"; ma=2592000"
	}
}

# HTTPS with QUIC/HTTP3 (Production Ready)
# Uncomment when ready for production with SSL certificates
# https://your-domain.com {
#     tls internal
#
#     # Enable HTTP/3
#     protocols h1 h2 h3
#
#     reverse_proxy sveltekit-1:5173 sveltekit-2:5174 {
#         header_up Host {host}
#         header_up X-Real-IP {remote_host}
#         header_up X-Forwarded-For {remote_host}
#         header_up X-Forwarded-Proto {scheme}
#         lb_policy round_robin
#     }
#
#     @websocket {
#         header Connection *Upgrade*
#         header Upgrade websocket
#     }
#     reverse_proxy @websocket sveltekit-1:5173 sveltekit-2:5174
# }

# Comprehensive Health Check Endpoint (Port 8888)
:8888 {
	header Content-Type application/json

	# Enhanced health check with service discovery
	respond /health `{
		"status": "healthy",
		"timestamp": "{time}",
		"protocol": "QUIC/HTTP3",
		"services": {
			"sveltekit_instances": [
				"sveltekit-1:5173",
				"sveltekit-2:5174"
			],
			"ai_services": {
				"tensorrt_bridge": "tensorrt-bridge:8087",
				"tensorrt_legal": "tensorrt-legal:8090",
				"tensorrt_270m": "tensorrt-270m:8091",
				"ollama_fallback": "ollama:11434"
			},
			"data_services": {
				"postgresql": "postgres:5432",
				"redis": "redis:6379",
				"qdrant": "qdrant:6333"
			}
		},
		"load_balancer": "round_robin",
		"cors": "enhanced_quic_enabled",
		"security": {
			"headers": "enforced",
			"tls": "ready",
			"quic": "experimental_enabled"
		},
		"memory_allocation": {
			"tensorrt_legal": "7GB VRAM",
			"tensorrt_270m": "512MB VRAM",
			"total_gpu": "RTX 3060 Ti 8GB"
		}
	}` 200

	respond "Legal AI Platform Health Check - QUIC/HTTP3 Ready" 200
}