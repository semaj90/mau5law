# Caddy QUIC proxy to existing local dev server
:5178 {
    # HTTP/3 QUIC support
    header Alt-Svc "h3=\":5178\"; ma=3600"

    # Network-accessible CORS
    header Access-Control-Allow-Origin "*"
    header Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS, PATCH"
    header Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With, Accept, Origin"
    header Access-Control-Allow-Credentials "true"

    # Handle preflight
    @options method OPTIONS
    handle @options {
        respond 200
    }

    # Proxy to your existing local dev server on host
    reverse_proxy host.docker.internal:5177 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}

        # Handle WebSocket for HMR
        header_up Upgrade {>Upgrade}
        header_up Connection {>Connection}
    }

    encode gzip
    log
}

# Health check endpoint
:8082 {
    handle /health {
        respond `{
            "status": "ready",
            "proxy_target": "host.docker.internal:5177",
            "agent_demo": "http://localhost:5178/agent-demo",
            "quic_enabled": true,
            "local_dev": true
        }` 200
    }

    respond "🚀 Caddy QUIC Proxy Ready - Forwarding to Local Dev Server" 200
}