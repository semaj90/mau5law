# Use cached Python base image instead of massive TensorRT
FROM python:3.10-slim

# Set working directory
WORKDIR /app

# Use system cache for apt packages
RUN --mount=type=cache,target=/var/cache/apt \
    --mount=type=cache,target=/var/lib/apt \
    apt-get update && apt-get install -y \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy only requirements first for better cache utilization
COPY requirements-legal.txt .

# Use pip cache mount to avoid re-downloading packages
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --no-cache-dir -r requirements-legal.txt

# Copy embedding adapter and models
COPY embedding_adapter_512.py .
COPY embedding_adapter_512.pkl .
COPY legal_vector_db_512.json .

# Copy test scripts
COPY test_ollama_models.py .

# Copy training guides
COPY Ollama_Legal_AI_Training_Guide.txt .
COPY Legal_AI_Vector_Search_Complete_Guide.txt .

# Environment variables for Ollama connection
ENV OLLAMA_HOST=host.docker.internal:11434
ENV PYTHONUNBUFFERED=1

# Expose port for API
EXPOSE 8100

# Run the embedding adapter
CMD ["python", "embedding_adapter_512.py"]