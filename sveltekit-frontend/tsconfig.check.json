{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "skipLibCheck": true,
    "checkJs": false,
    "isolatedModules": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.svelte",
    "src/**/*.d.ts"
  ],
  "exclude": [
    "node_modules/**",
    ".svelte-kit/**",
    "dist/**",
    "build/**",
    // Heavy or corrupted areas to ignore for focused checks
    "src/lib/services/**",
    "src/lib/components/upload/**",
    "src/lib/examples/**",
    "src/stories/**",
    "src/proto/**",
    "src/lib/server/db/**",
    "src/lib/experimental/**",
    "src/lib/ai/_experimental/**"
  ]
}
