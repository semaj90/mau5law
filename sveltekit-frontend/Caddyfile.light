# Lightweight Caddy configuration for agent demo
:5178 {
    # HTTP/3 support
    header Alt-Svc "h3=\":5178\"; ma=3600"

    # Basic CORS
    header Access-Control-Allow-Origin "*"
    header Access-Control-Allow-Methods "*"
    header Access-Control-Allow-Headers "*"

    # Agent demo and API routes
    reverse_proxy vite-dev:5174

    encode gzip
    log
}

# Simple health check
:8082 {
    handle /health {
        respond `{"status": "ready", "agent_demo": "http://localhost:5178/agent-demo"}` 200
    }
    respond "Agent Demo Ready 🤖" 200
}