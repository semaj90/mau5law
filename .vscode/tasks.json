  "inputs": [
    {
      "id": "aceTask",
      "type": "promptString",
      "description": "Enter the task for the ACE Agent (e.g., 'Analyze Postgres login errors', 'Fix TypeScript import errors')",
      "default": "Analyze the most common TypeScript errors and suggest fixes"
    },
    {
      "id": "llmPrompt",
      "type": "promptString",
      "description": "Enter a prompt to compare across all LLM providers",
