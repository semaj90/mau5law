# Docker Development Caddy Configuration with QUIC/HTTP3
# Network-accessible development server with full stack integration

# Main development server with QUIC/HTTP3
:5178 {
    # HTTP/3 Advertisement
    header Alt-Svc "h3=\":5178\"; ma=3600"

    # Development CORS (permissive for docker network)
    header Access-Control-Allow-Origin "*"
    header Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS, PATCH"
    header Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With, Accept, Origin"
    header Access-Control-Allow-Credentials "true"

    # Handle preflight requests
    @options {
        method OPTIONS
    }
    handle @options {
        respond 200
    }

    # Agent Demo API routes
    handle /api/agent/* {
        reverse_proxy vite-dev:5174 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # All other API routes
    handle /api/* {
        reverse_proxy vite-dev:5174 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # WebSocket for HMR (Hot Module Replacement)
    handle /vite-dev/* {
        reverse_proxy vite-dev:24678 {
            header_up Upgrade {>Upgrade}
            header_up Connection {>Connection}
        }
    }

    # Static assets and SvelteKit app
    reverse_proxy vite-dev:5174 {
        transport http {
            keepalive 30s
            keepalive_idle_conns 5
        }

        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}

        # Handle dev server restarts gracefully
        fail_duration 5s
        max_fails 3
        unhealthy_latency 10s
    }

    # Gzip compression
    encode gzip

    # Development logging
    log {
        output stdout
        format console
        level INFO
    }
}

# Alternative port for testing
:5179 {
    header Alt-Svc "h3=\":5179\"; ma=3600"
    header Access-Control-Allow-Origin "*"

    reverse_proxy vite-dev:5174 {
        fail_duration 2s
    }

    encode gzip
}

# Health check and development info endpoint
:8082 {
    handle /health {
        respond 200 {
            body `{
                "status": "healthy",
                "environment": "docker-development",
                "service": "legal-ai-platform-dev",
                "protocol": "QUIC/HTTP3",
                "vite_server": "vite-dev:5174",
                "caddy_proxy": "caddy:5178",
                "postgres": "postgres:5432",
                "redis": "redis:6379",
                "ollama": "ollama:11434",
                "minio": "minio:9000",
                "timestamp": "{time.now.unix}",
                "version": "dev-docker"
            }`
            close
        }
    }

    handle /agent-demo {
        redir /agent-demo http://localhost:5178/agent-demo permanent
    }

    handle /dev-info {
        respond 200 {
            body `{
                "docker_services": {
                    "frontend_quic": "http://localhost:5178",
                    "frontend_alt": "http://localhost:5179",
                    "agent_demo": "http://localhost:5178/agent-demo",
                    "api_endpoints": "http://localhost:5178/api/",
                    "postgres": "postgres:5432",
                    "redis": "redis:6379",
                    "ollama": "ollama:11434",
                    "minio_console": "http://localhost:9001",
                    "minio_api": "minio:9000"
                },
                "capabilities": {
                    "quic_http3": true,
                    "websockets": true,
                    "cors_enabled": true,
                    "hot_reload": true,
                    "agent_demo": true,
                    "rag_system": true,
                    "diff_patches": true
                }
            }`
            close
        }
    }

    # Default dev info
    respond "🚀 Legal AI Development Stack Ready - Docker + QUIC + Agent Demo" 200
}