{
  "extends": "./.svelte-kit/tsconfig.json",
  "compilerOptions": {
    "module": "esnext",
    "target": "es2022",
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "strict": false,
    "esModuleInterop": true,
    "types": ["svelte"]
  },
  "include": [
    "src/**/*",
    "svelte.config.js",
    "vite.config.js",
    "src/**/*.d.ts",
    "src/**/*.js",
    "src/**/*.ts",
    "src/**/*.svelte"
  ],
  "exclude": [
    "node_modules",
    "build",
    ".svelte-kit",
    "dist",
    "archived/**",
    "archived-components/**",
    ".svelte-check-tmp/**",
    "../.rag-metrics/**",
    "src/tests/**",
    "src/stories/**",
    "src/lib/experimental/**",
    "src/lib/ai/_experimental/**",
    "src/lib/examples/**",
    "src/routes/api/ai/gpu/**",
    "src/lib/components/gpu/**",
    "src/lib/engines/**",
    "src/lib/gpu/**",
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/node_modules/**",
    "src/proto/**",
    "src/**/*.js",
    "src/grpc/**",
    "src/flatbuf/**",
    "src/wasm/**",
    "**/*.worker.ts",
    "**/*.sw.ts",
    "**/service-worker.ts"
  ]
}
