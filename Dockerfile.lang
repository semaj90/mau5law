# Phase 70: Language Extraction Service Dockerfile
FROM python:3.12-slim

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy Python service
COPY python-services/lang_extract_service.py /app/

# Install Python dependencies
RUN pip install --no-cache-dir fastapi uvicorn spacy nltk scikit-learn

# Download spaCy model
RUN python -m spacy download en_core_web_sm

# Expose port
EXPOSE 8102

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8102/health || exit 1

# Run service
CMD ["python", "lang_extract_service.py"]