# Phase 72: Progress Monitoring Service Dockerfile
FROM node:18-alpine

# Install monitoring tools
RUN apk add --no-cache \
    curl \
    jq \
    && rm -rf /var/cache/apk/*

# Set working directory
WORKDIR /app

# Copy package files
COPY phase72-ast-reduction/package*.json ./

# Install dependencies
RUN npm ci --only=production

# Copy source code
COPY phase72-ast-reduction/ ./

# Create progress directory
RUN mkdir -p /app/progress && \
    chown -R node:node /app/progress

# Create non-root user
USER node

# Health check
HEALTHCHECK --interval=60s --timeout=10s --start-period=5s --retries=3 \
    CMD node -e "console.log('Progress Monitor Healthy')" || exit 1

# Default command - monitor progress every 60 seconds
CMD ["sh", "-c", "while true; do node phase72-orchestrator.ts progress >> /app/progress/monitor.log 2>&1; sleep 60; done"]