		{
			"label": "Deploy Qdrant with GPU Support",
			"type": "shell",
			"command": "docker",
			"args": [
				"run",
				"-d",
				"--name",
				"qdrant-gpu",
				"--gpus",
				"all",
				"-p",
				"6333:6333",
				"-p",
				"6334:6334",
				"-v",
				"qdrant_storage:/qdrant/storage",
				"-v",
				"qdrant_snapshots:/qdrant/snapshots",
				"-e",
				"QDRANT_API_KEY=your-api-key",
				"qdrant/qdrant:latest-gpu"
			],
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared",
				"showReuseMessage": true,
				"clear": false
