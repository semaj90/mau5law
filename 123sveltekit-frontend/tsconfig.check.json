{
  "extends": "./tsconfig.json",
  "include": [
    "ambient.d.ts",
    "src/**/*.ts",
    "src/**/*.svelte",
    "src/types/**/*.d.ts",
    "src/lib/types/**/*.d.ts"
  ],
  "exclude": [
    "tests/**",
  "src/lib/tests/**",
    "src/**/__tests__/**",
    "src/**/__mocks__/**",
    "node_modules/**",
    ".svelte-kit/**",
    "dist/**",
    "build/**"
  ]
}
