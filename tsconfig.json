{
  "compilerOptions": {
    "moduleResolution": "nodenext", // use NodeNext for modern Node ESM behavior
    "module": "NodeNext", // match moduleResolution for proper ESM support
    "sourceMap": false, // disable source maps for smaller production builds
    "inlineSources": false,
    "target": "ES2023", // bump target for Node 22 features
    "lib": ["DOM", "DOM.Iterable", "ES2023"], // align libs with target
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "types": ["node"], // removed "svelte" so tsc won't search for a missing 'svelte' type library
    "isolatedModules": true,
    "strict": true, // Enable strict mode for better type safety
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true, // prevent tsc from writing .js outputs that conflict with Svelte/Vite
    "baseUrl": ".",
    "paths": {
      "$lib/*": ["src/lib/*"],
      "$components/*": ["src/lib/components/*"],
      "$services/*": ["src/lib/services/*"],
      "$types/*": ["src/lib/types/*"],
      "$utils/*": ["src/lib/utils/*"]
    },
    "typeRoots": [
      "./node_modules/@types",
      "./sveltekit-frontend/src/lib/types",
      "./sveltekit-frontend/src/lib/types/vendor"
    ]
  },
  // ensure the proto outputs are part of the project used by eslint's parser
  "include": [
    "sveltekit-frontend/src/**/*",
    "sveltekit-frontend/**/*.svelte",
    "src/**/*",
    "uno.config.ts",
    "playwright.config.ts",
    "types.d.ts",
    "sveltekit-frontend/src/lib/types/vendor/**/*.d.ts",
    "**/*.svelte",
    "src/proto/**/*.js"
  ],
  "exclude": [
    "node_modules/**",
    "build/**",
    "dist/**",
    ".svelte-kit/**",
    "**/*.svelte.js"
    // removed the previous "sveltekit-frontend/**" exclusion so Svelte sources are processed
  ]
}
