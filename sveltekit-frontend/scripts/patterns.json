[
	{
		"id": "db-import",
		"description": "Fix import { db } to import db (default export)",
		"regex": "import\\s+\\{\\s*db\\s*\\}\\s+from\\s+['\"](\\$lib\\/server\\/db[^'\"]*)['\"]",
		"fixTemplate": "import db from '$lib/server/db...'",
		"priority": 1,
		"domains": ["backend", "db"],
		"scope": "ts",
		"risk": "safe",
		"requires": ["fileExists:src/lib/server/db.ts"],
		"patchKind": "replace"
	},
	{
		"id": "drizzle-enum",
		"description": "Fix Drizzle enum mismatches (active→open, done→closed)",
		"regex": "eq\\(cases\\.status,\\s*['\"](active|done|reviewing|completed)['\"]\\)",
		"fixTemplate": "eq(cases.status, 'open'|'closed'|'pending_review')",
		"priority": 2,
		"domains": ["backend", "db"],
		"scope": "ts",
		"risk": "medium",
		"requires": ["contains:cases.status"],
		"patchKind": "replace"
	},
	{
		"id": "drizzle-active-cases",
		"description": "Fix eq(cases.status, \"active\") to proper not-closed/archived logic",
		"regex": "eq\\(cases\\.status,\\s*['\"]active['\"]\\)",
		"fixTemplate": "ne(cases.status, 'closed'), ne(cases.status, 'archived')",
		"priority": 2,
		"domains": ["backend", "db"],
		"scope": "ts",
		"risk": "medium",
		"requires": ["contains:cases.status"],
		"patchKind": "replace"
	},
	{
		"id": "get-user-id",
		"description": "Replace getUserId(locals) with locals.user?.id guard",
		"regex": "getUserId\\(locals\\)",
		"fixTemplate": "const userId = locals.user?.id; if (!userId) throw error(401);",
		"priority": 3,
		"domains": ["backend", "auth"],
		"scope": "ts",
		"risk": "medium",
		"requires": ["contains:locals"],
		"patchKind": "codemod"
	},
	{
		"id": "get-ollama-endpoint-import",
		"description": "Fix import type { getOllamaEndpoint } -> import { getOllamaEndpoint }",
		"regex": "import\\s+type\\s+\\{\\s*getOllamaEndpoint\\s*\\}\\s+from",
		"fixTemplate": "import { getOllamaEndpoint } from ...",
		"priority": 3,
		"domains": ["backend", "ai"],
		"scope": "ts",
		"risk": "safe",
		"requires": [],
		"patchKind": "replace"
	},
	{
		"id": "svelte-rest-route",
		"description": "Fix [[...path]] in Svelte <style> blocks",
		"regex": "\\[\\[\\.\\.\\.path\\]\\]",
		"fixTemplate": "[...path]",
		"priority": 4,
		"domains": ["frontend", "svelte"],
		"scope": "svelte",
		"risk": "safe",
		"requires": ["contains:<style"],
		"patchKind": "replace"
	},
	{
		"id": "env-vars-global",
		"description": "Fix missing process.env prefix for known environment variables",
		"regex": "(?<![\\w.'\"])(DATABASE_URL|OLLAMA_URL|QDRANT_URL|AUTH_COOKIE_NAME)(?![\\w:])",
		"fixTemplate": "process.env.$1",
		"priority": 4,
		"domains": ["backend", "config"],
		"scope": "ts",
		"risk": "high",
		"requires": ["notContains:$env/"],
		"patchKind": "replace"
	},
	{
		"id": "superforms-adapter",
		"description": "Fix zodClient → zod adapter on server files",
		"regex": "zodClient\\(",
		"fixTemplate": "zod(...)",
