# Use cached Ubuntu with optimized setup for your RTX 3060 Ti
FROM ubuntu:22.04

# Set environment for your RTX 3060 Ti + TensorRT
ENV CUDA_VISIBLE_DEVICES=0
ENV NVIDIA_VISIBLE_DEVICES=all
ENV TENSORRT_OPTIMIZATION=1
ENV LEGAL_AI_MODE=production

WORKDIR /app

# Install Python 3.12 to match your working system
RUN apt-get update && apt-get install -y \
    python3.12 \
    python3.12-dev \
    python3-pip \
    curl \
    && ln -sf /usr/bin/python3.12 /usr/bin/python \
    && rm -rf /var/lib/apt/lists/*

# Use pip cache to leverage your successful installations
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install \
    torch>=2.7.1 \
    numpy>=1.26.0 \
    fastapi>=0.115.0 \
    uvicorn \
    ollama>=0.3.0 \
    scikit-learn

# Copy your working legal AI system
COPY embedding_adapter_512.py .
COPY embedding_adapter_512.pkl .
COPY legal_vector_db_512.json .
COPY Legal_AI_Vector_Search_Complete_Guide.txt .

# TensorRT optimization flags for RTX 3060 Ti (Ampere architecture)
ENV TORCH_CUDA_ARCH_LIST="8.6"
ENV CUDA_LAUNCH_BLOCKING=0
ENV PYTORCH_CUDA_ALLOC_CONF="max_split_size_mb:512"

# Create API server
RUN cat > api_server.py << 'PYEOF'
#!/usr/bin/env python3
import uvicorn
from fastapi import FastAPI
from embedding_adapter_512 import EmbeddingAdapter512
import torch

app = FastAPI(title="Legal AI Vector Search", version="1.0.0")
adapter = EmbeddingAdapter512()

@app.get("/health")
async def health():
    return {
        "status": "healthy", 
        "gpu_available": torch.cuda.is_available(),
        "cuda_version": torch.version.cuda if torch.cuda.is_available() else None,
        "gpu_name": torch.cuda.get_device_name(0) if torch.cuda.is_available() else None
    }

@app.post("/embeddings")
async def generate_embeddings(text: str):
    embedding = adapter.get_legal_embedding_512(text)
    return {
        "embedding": embedding.tolist(), 
        "dimensions": len(embedding),
        "model": "embeddinggemma:latest",
        "status": "success"
    }

if __name__ == "__main__":
    uvicorn.run(app, host="0.0.0.0", port=8100)
PYEOF

RUN chmod +x api_server.py

EXPOSE 8100

# Health check for container monitoring
HEALTHCHECK --interval=30s --timeout=3s \
    CMD python -c "import requests; requests.get('http://localhost:8100/health')" || exit 1

CMD ["python", "api_server.py"]
