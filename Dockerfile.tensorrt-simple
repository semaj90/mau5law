# Simplified TensorRT Dockerfile - Python Only for Testing
# Skips Go dependencies to test model conversion quickly

FROM nvcr.io/nvidia/tensorrt:24.09-py3

# Set working directory
WORKDIR /app

# Install system dependencies including Go
RUN apt-get update && apt-get install -y \
    curl \
    wget \
    build-essential \
    python3-dev \
    git \
    && rm -rf /var/lib/apt/lists/*

# Install Go 1.21
RUN wget https://go.dev/dl/go1.21.13.linux-amd64.tar.gz && \
    tar -C /usr/local -xzf go1.21.13.linux-amd64.tar.gz && \
    rm go1.21.13.linux-amd64.tar.gz

ENV PATH=/usr/local/go/bin:$PATH

# Install minimal Python dependencies (skip complex builds)
RUN pip install --upgrade pip setuptools wheel packaging && \
    pip install --no-cache-dir \
    tensorrt \
    pycuda \
    torch>=2.4.0 \
    torchvision \
    torchaudio \
    transformers>=4.50.0 \
    requests>=2.31.0 \
    fastapi>=0.108.0 \
    uvicorn>=0.25.0 \
    numpy \
    psutil

# Copy Go microservice source
COPY go-microservice/tensorrt/legal-tensorrt-service-simple.go /app/
COPY go-microservice/go.mod go-microservice/go.sum /app/

# Build Go service
RUN cd /app && go mod tidy && go build -o legal-tensorrt-service legal-tensorrt-service-simple.go

# Copy model conversion scripts if they exist
RUN touch /app/dummy.py

# Create model directories
RUN mkdir -p /app/models /app/tensorrt_cache /app/logs

# Set environment variables for Q4_K_M service
ENV CUDA_VISIBLE_DEVICES=0
ENV PORT=8100
ENV RTX_3060_OPTIMIZATION=true
ENV Q4KM_MIXED_PRECISION=true
ENV MAX_CONTEXT_LENGTH=131072
ENV EMBEDDING_DIM=3840

# Expose port for health checks
EXPOSE 8100

# Simple startup script for testing
RUN cat > /app/test_tensorrt.sh << 'EOF'
#!/bin/bash
echo "🚀 Testing TensorRT Legal AI Model Conversion"
echo "============================================="

# Check GPU availability
echo "🔍 Checking GPU access..."
nvidia-smi || (echo "❌ GPU not accessible" && exit 1)

# Check TensorRT installation
echo "🔧 Checking TensorRT installation..."
python3 -c "import tensorrt as trt; print(f'TensorRT version: {trt.__version__}')" || exit 1

# Check PyTorch CUDA
echo "🔥 Checking PyTorch CUDA support..."
python3 -c "import torch; print(f'PyTorch CUDA available: {torch.cuda.is_available()}')" || exit 1

# Test model converter help
echo "📋 Testing model converter..."
python3 /app/model_converter.py --help

echo "✅ TensorRT environment ready for model conversion!"
echo "🎯 Next: python3 model_converter.py --model embeddinggemma:latest --benchmark"
EOF

RUN chmod +x /app/test_tensorrt.sh

# Health check for Go service
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:8100/health || exit 1

# Start the Q4_K_M service
CMD ["./legal-tensorrt-service"]