import tensorrt as trt
import pycuda.driver as cuda
import pycuda.autoinit
import numpy as np
from typing import Optional, Tuple

class TensorRTFlashAttentionEngine:
    def __init__(self, model_path: str, max_seq_len: int = 8192):
        self.max_seq_len = max_seq_len
        self.engine = self._load_engine(model_path)
        self.context = self.engine.create_execution_context()

    def _load_engine(self, model_path: str):
        """Load TensorRT engine with FlashAttention plugin"""
        logger = trt.Logger(trt.Logger.WARNING)

        # Register FlashAttention plugin
        trt.init_libnvinfer_plugins(logger, "")

        with open(model_path, 'rb') as f:
            engine_data = f.read()

        runtime = trt.Runtime(logger)
        engine = runtime.deserialize_cuda_engine(engine_data)

        return engine

    def infer_q4km_with_flash_attention(self,
                                       input_ids: np.ndarray,
                                       attention_mask: Optional[np.ndarray] = None) -> np.ndarray:
        """
        Run Q4_K_M inference with FlashAttention optimization

        Args:
            input_ids: Token IDs [batch_size, seq_len]
            attention_mask: Attention mask [batch_size, seq_len]

        Returns:
            embeddings: Output embeddings [batch_size, seq_len, hidden_size]
        """
        batch_size, seq_len = input_ids.shape

        # Allocate GPU memory
        input_mem = cuda.mem_alloc(input_ids.nbytes)

        # Calculate output size (assuming 3840 dim embeddings)
        output_shape = (batch_size, seq_len, 3840)
        output_size = np.prod(output_shape) * 4  # float32
        output_mem = cuda.mem_alloc(output_size)

        # Copy input to GPU
        cuda.memcpy_htod(input_mem, input_ids.astype(np.float32))

        # Set tensor addresses
        self.context.set_tensor_address("input_ids", int(input_mem))
        self.context.set_tensor_address("embeddings", int(output_mem))

        # Execute inference with FlashAttention
        self.context.execute_async_v3(stream_handle=0)

        # Copy result back
        output = np.empty(output_shape, dtype=np.float32)
        cuda.memcpy_dtoh(output, output_mem)

        # Cleanup
        input_mem.free()
        output_mem.free()

        return output

def create_q4km_flash_attention_engine(onnx_path: str, engine_path: str):
    """Convert ONNX model to TensorRT engine with FlashAttention plugin"""
    logger = trt.Logger(trt.Logger.WARNING)

    # Initialize plugins
    trt.init_libnvinfer_plugins(logger, "")

    builder = trt.Builder(logger)
    config = builder.create_builder_config()

    # Enable FP16 for better performance
    config.set_flag(trt.BuilderFlag.FP16)
    config.set_flag(trt.BuilderFlag.GPU_FALLBACK)

    # Set memory pool size
    config.set_memory_pool_limit(trt.MemoryPoolType.WORKSPACE, 2 << 30)  # 2GB

    network = builder.create_network(1 << int(trt.NetworkDefinitionCreationFlag.EXPLICIT_BATCH))
    parser = trt.OnnxParser(network, logger)

    with open(onnx_path, 'rb') as model:
        if not parser.parse(model.read()):
            for error in range(parser.num_errors):
                print(parser.get_error(error))
            return None

    # Build and save engine
    engine = builder.build_engine(network, config)

    with open(engine_path, 'wb') as f:
        f.write(engine.serialize())

    print(f"✅ TensorRT engine with FlashAttention saved to {engine_path}")
    return engine

if __name__ == "__main__":
    print("🚀 TensorRT FlashAttention Q4_K_M Engine Ready")
