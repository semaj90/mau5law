{
  "compilerOptions": {
    "types": ["svelte", "vite/client", "vitest/globals", "@sveltejs/kit", "@webgpu/types", "node"],
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": false,
    "noEmit": true,
    "isolatedModules": true,
    "strict": false,
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "allowJs": true,
    "checkJs": false,
    "esModuleInterop": true,
    "allowImportingTsExtensions": false,
    "forceConsistentCasingInFileNames": false,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "incremental": false,
    "downlevelIteration": true,
    "noImplicitAny": false,
    "noImplicitThis": false,
    "noImplicitReturns": false,
    "noImplicitOverride": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "exactOptionalPropertyTypes": false,
    "noErrorTruncation": true,
    "preserveSymlinks": false,
    "useDefineForClassFields": true,
    "paths": {
      "$lib": ["./src/lib"],
      "$lib/*": ["./src/lib/*"],
      "$components": ["./src/lib/components"],
      "$components/*": ["./src/lib/components/*"],
      "$stores": ["./src/lib/stores"],
      "$stores/*": ["./src/lib/stores/*"],
      "$utils": ["./src/lib/utils"],
      "$utils/*": ["./src/lib/utils/*"],
      "$types": ["./src/lib/types"],
      "$types/*": ["./src/lib/types/*"],
      "$app/types": ["./.svelte-kit/types/index.d.ts"]
    }
  },
  "include": [
    "ambient.d.ts",
    "src/app.d.ts",
    "src/global.d.ts",
    "src/routes/**/*.ts",
    "src/hooks/**/*.ts",
    "src/params/**/*.ts",
    "src/**/*.svelte",
    "src/types/**/*.d.ts",
    "src/lib/types/**/*.d.ts",
    "tests/**/*.ts",
    "src/lib/components/**/*.ts",
    "src/lib/components/**/*.svelte",
    "src/lib/stores/**/*.ts",
    "src/lib/utils/**/*.ts"
  ],
  "exclude": [
    "node_modules/**",
    "build/**",
    "dist/**",
    ".svelte-kit/**",
    "logs/**",
    "tmp/**",
    "*.log",
    "coverage/**",
    ".vscode/**",
    "storybook-static/**",
    "archived-components/**",
    "src/wasm/**/*.ts",
    "src/**/wasm/**/*.ts",
    "src/**/*-wasm.ts",
    "src/**/*.wasm.ts",
    "src/lib/gpu/**/*.ts",
    "src/lib/evidence/simd-gpu-tiling-engine.ts",
    "src/lib/evidence/detective-analysis-engine.ts",
    "src/lib/examples/webgpu-buffer-usage-examples.ts",
    "src/lib/components/three/yorha-ui/NESYoRHaHybrid3D.ts",
    "src/lib/components/three/yorha-ui/webgpu/**/*.ts",
    "src/lib/client/ocr-tensor-processor.ts",
    "src/lib/cache/**/*.ts",
    "src/lib/caching/**/*.ts",
    "src/lib/integrations/enhanced-rabbitmq-cuda-bridge.ts",
    "src/lib/db/schema/rag-integration.ts",
    "src/lib/server/thread-safe-postgres.ts",
    "src/lib/server/gpu-thread-coordinator.ts",
    "src/lib/server/concurrent-json-serializer.ts",
    "src/lib/services/gpu-cache-orchestrator.ts",
    "src/lib/services/cognitive-cache-integration.ts",
    "src/lib/services/concurrent-indexeddb-search.ts",
    "src/lib/services/simd-redis-client.ts",
    "src/lib/adapters/webasm-ai-adapter.ts",
    "src/lib/services/**/*-gpu-*.ts",
    "src/lib/services/**/*-cuda-*.ts",
    "src/lib/services/**/*-wasm-*.ts",
    "src/lib/components/**/*-test-*.svelte",
    "src/lib/components/**/experimental-*.svelte",
    "src/routes/**/experiments/**",
    "src/routes/**/test-pages/**",
    "src/lib/ai/**/*.ts"
  ]
}