# Caddy HTTP/3 QUIC Proxy Configuration for Legal AI Production Pipeline

{
    # Global options for HTTP/3 and performance
    experimental_http3
    servers {
        protocols h1 h2 h3
        timeouts {
            read_header 10s
            read_body 30s
            write 60s
            idle 5m
        }
    }
    
    # Enable logging
    log {
        output file ./caddy.log
        level INFO
        format json
    }
}

# Development SvelteKit server (existing)
:5173 {
    protocols h1 h2 h3
    
    # Alt-Svc header for HTTP/3 upgrade
    header Alt-Svc "h3=\":5173\"; ma=86400"
    
    # Reverse proxy to Vite dev server
    reverse_proxy localhost:5174 {
        # Enable websocket for HMR
        @websockets {
            header Connection *Upgrade*
            header Upgrade websocket
        }
        handle @websockets {
            reverse_proxy localhost:5174
        }
        
        # Connection pooling
        transport http {
            keepalive 30s
            keepalive_idle_conns 5
        }
    }
    
    # Enable compression
    encode {
        gzip 6
        zstd
    }
    
    # CORS headers for development
    @cors_preflight {
        method OPTIONS
    }
    respond @cors_preflight 204 {
        header Access-Control-Allow-Origin *
        header Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
        header Access-Control-Allow-Headers "Content-Type, Authorization"
    }
    
    header {
        Access-Control-Allow-Origin *
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        X-XSS-Protection "1; mode=block"
    }
}

# Production Legal AI Application with GPU Integration
legal-ai.localhost:443 {
    protocols h1 h2 h3
    
    header {
        Alt-Svc "h3=\":443\"; ma=86400"
        Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ws: wss:; font-src 'self' data:;"
    }
    
    encode {
        gzip 6
        zstd
    }
    
    # Static asset caching
    @static {
        path *.js *.css *.woff2 *.png *.jpg *.svg *.ico
    }
    header @static Cache-Control "public, max-age=31536000, immutable"
    
    # GPU Processing API routes (Phase 2 integration)
    handle /api/gpu-processing* {
        # No caching for real-time GPU processing
        header Cache-Control "no-cache, no-store, must-revalidate"
        header Pragma "no-cache"
        
        reverse_proxy localhost:5173 {
            transport http {
                keepalive 30s
                keepalive_idle_conns 5
                read_timeout 60s  # GPU processing may take longer
                write_timeout 60s
            }
        }
    }
    
    # Neural Dashboard metrics WebSocket
    handle /api/neural-metrics* {
        @websocket_neural {
            header Connection Upgrade
            header Upgrade websocket
        }
        reverse_proxy @websocket_neural localhost:5173
        
        # Regular HTTP fallback
        reverse_proxy localhost:5173
    }
    
    # Unified System Orchestrator endpoints
    handle /api/unified/* {
        header Cache-Control "public, max-age=60, stale-while-revalidate=30"
        
        reverse_proxy localhost:5173 {
            transport http {
                keepalive 30s
                read_timeout 120s  # Longer timeout for complex processing
            }
        }
    }
    
    # Standard API routes with selective caching
    handle /api/* {
        @cacheable_api {
            path /api/documents/* /api/search/* /api/legal/*
        }
        
        header @cacheable_api {
            Cache-Control "public, max-age=300, stale-while-revalidate=60"
            Vary "Accept-Encoding, Authorization"
        }
        
        reverse_proxy localhost:5173 {
            transport http {
                keepalive 30s
                keepalive_idle_conns 10
            }
            health_uri /api/health
            health_interval 30s
        }
    }
    
    # WebSocket support for real-time features
    @websocket {
        header Connection Upgrade
        header Upgrade websocket
    }
    reverse_proxy @websocket localhost:5173
    
    # Main app
    reverse_proxy localhost:5173
}

# gRPC Gateway for Go microservices
grpc-api.localhost:443 {
    protocols h1 h2 h3
    
    header {
        Alt-Svc "h3=\":443\"; ma=86400"
        Access-Control-Allow-Origin "*"
        Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
        Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With"
    }
    
    # CORS preflight
    @options {
        method OPTIONS
    }
    respond @options 204
    
    # gRPC endpoints
    handle /grpc/* {
        reverse_proxy h2c://localhost:8095 {
            transport http {
                versions h2c
            }
        }
    }
    
    # RESTful API
    reverse_proxy localhost:8095 {
        transport http {
            keepalive 30s
        }
        header_up X-Forwarded-Proto {scheme}
        header_up X-Real-IP {remote_host}
    }
}

# Document processing service
docs-api.localhost:443 {
    protocols h1 h2 h3
    
    header Alt-Svc "h3=\":443\"; ma=86400"
    
    # Large file support
    request_body {
        max_size 100MB
    }
    
    # OCR processing
    handle /ocr/* {
        reverse_proxy localhost:8096 {
            transport http {
                read_timeout 300s
                write_timeout 300s
            }
        }
    }
    
    # Embedding service
    handle /embed/* {
        reverse_proxy localhost:8097 {
            transport http {
                read_timeout 120s
            }
        }
    }
    
    # Vector search with caching
    handle /search/* {
        header Cache-Control "public, max-age=600, stale-while-revalidate=120"
        reverse_proxy localhost:8098
    }
    
    reverse_proxy localhost:8096
}

# MinIO S3 storage proxy
storage.localhost:443 {
    protocols h1 h2 h3
    
    header Alt-Svc "h3=\":443\"; ma=86400"
    
    request_body {
        max_size 500MB
    }
    
    reverse_proxy localhost:4002 {
        transport http {
            keepalive 30s
            keepalive_idle_conns 10
        }
        header_up Host localhost:4002
    }
}

# Redis management (optional)
cache-admin.localhost:443 {
    protocols h1 h2 h3
    header Alt-Svc "h3=\":443\"; ma=86400"
    
    basicauth {
        admin $2a$10$example_hash_here
    }
    
    reverse_proxy localhost:8081
}

