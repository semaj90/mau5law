# Caddy configuration for QUIC proxy to local SvelteKit dev server and vector backend
# Listens on port 5178 with QUIC (HTTP/3) enabled and fronts both the Vite dev server
# and the local vector processing service.

{
  # Ensure handle_path routes run before the default reverse proxy fallback.
  order handle_path before reverse_proxy
}

localhost:5178 {
  # Enable HTTP/3 (QUIC)
  protocols h1 h2 h3

  # Health check endpoint (kept before other handlers)
  handle /health {
    respond "OK" 200
  }

  # Proxy vector service traffic through Caddy so the frontend can reach it via QUIC.
  # The upstream address defaults to a local host binding but can be overridden via
  # VECTOR_BACKEND_URL when starting the container.
  handle_path /vector/* {
    reverse_proxy {env.VECTOR_BACKEND_URL http://host.docker.internal:8095}
  }

  # Default: proxy application traffic to the SvelteKit dev server.
  handle {
    reverse_proxy {env.VITE_DEV_SERVER http://host.docker.internal:5173} {
      # Preserve original headers for dev server
      header_up Host {http.request.host}
      header_up X-Forwarded-For {http.request.remote}
      header_up X-Forwarded-Proto {http.request.scheme}

      # WebSocket support for SvelteKit HMR
      transport http {
        read_timeout 30s
        write_timeout 30s
      }
    }
  }

  # Enable compression
  encode gzip

  # Logging
  log {
    output stdout
    format console
  }
}
