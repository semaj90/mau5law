# Enhanced Caddy Configuration for QUIC/HTTP3 Legal AI Platform
# Supports: SvelteKit Frontend + Go Microservices + FastAPI + Ollama
# Generated: 2025-09-14 with Full Service Architecture

# Primary HTTPS with self-signed certificate
localhost:443 {
    # Generate self-signed certificate for localhost development
    tls internal

    # Enable HTTP/3 with Alt-Svc header for QUIC performance
    header Alt-Svc "h3=\":443\"; ma=86400"

    # Security headers for production-like environment
    header X-Content-Type-Options nosniff
    header X-Frame-Options DENY
    header X-XSS-Protection "1; mode=block"
    header Referrer-Policy strict-origin-when-cross-origin

    # WebSocket support for Vite HMR with priority
    @websockets {
        header Connection *Upgrade*
        header Upgrade websocket
    }
    reverse_proxy @websockets frontend:5173 {
        header_up Host {host}
        header_up X-Real-IP {remote}
        header_up X-Forwarded-For {remote}
        header_up X-Forwarded-Proto {scheme}
    }

    # Frontend routes (SvelteKit assets and pages)
    @frontend {
        path / /assets* /build* /src* /_app* /favicon.ico
    }
    reverse_proxy @frontend frontend:5173 {
        header_up Host {host}
        header_up X-Real-IP {remote}
        header_up X-Forwarded-For {remote}
        header_up X-Forwarded-Proto {scheme}
    }

    # API routes for FastAPI backend
    @api {
        path /api/*
    }
    reverse_proxy @api fastapi:8080 {
        header_up Host {host}
        header_up X-Real-IP {remote}
        header_up X-Forwarded-For {remote}
        header_up X-Forwarded-Proto {scheme}
        # Timeout for AI processing
        timeout 120s
    }

    # Tensor/AI processing routes
    @tensor {
        path /tensor/* /ai/* /embeddings/* /vectorize/*
    }
    reverse_proxy @tensor tensor-service:8081 {
        header_up Host {host}
        header_up X-Real-IP {remote}
        header_up X-Forwarded-For {remote}
        header_up X-Forwarded-Proto {scheme}
        # Extended timeout for heavy AI processing
        timeout 300s
    }

    # Go microservice routes (legal document processing)
    @legal {
        path /legal/* /documents/* /cases/* /search/*
    }
    reverse_proxy @legal go-microservice:8082 {
        header_up Host {host}
        header_up X-Real-IP {remote}
        header_up X-Forwarded-For {remote}
        header_up X-Forwarded-Proto {scheme}
    }

    # Ollama proxy (if containerized later)
    @ollama {
        path /ollama/*
    }
    reverse_proxy @ollama host.docker.internal:11434 {
        header_up Host {host}
        header_up X-Real-IP {remote}
        header_up X-Forwarded-For {remote}
        header_up X-Forwarded-Proto {scheme}
        # Very long timeout for model inference
        timeout 600s
    }

    # Enable compression for better performance
    encode gzip zstd

    # CORS headers for development (restrict in production)
    header Access-Control-Allow-Origin "https://localhost:443"
    header Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
    header Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With"
    header Access-Control-Allow-Credentials true

    # Handle preflight requests
    @options {
        method OPTIONS
    }
    respond @options 204

    # Default fallback to frontend for SPA routing
    try_files {path} {path}/ /index.html
}

# HTTP redirect to HTTPS
localhost:80 {
    redir https://localhost:443{uri} permanent
}

# Health check endpoint
localhost:443/health {
    tls internal
    respond 200 {
        body `{
            "status": "healthy",
            "protocol": "HTTP/3 (QUIC)",
            "services": {
                "frontend": "SvelteKit on :5173",
                "api": "FastAPI on :8080",
                "tensor": "Tensor Service on :8081",
                "legal": "Go Microservice on :8082",
                "ollama": "Ollama on host:11434"
            },
            "timestamp": "{time.now.format}"
        }`
        close
    }
}

# Development WebSocket debugging
localhost:443/ws-debug {
    tls internal
    respond 200 {
        body "WebSocket debugging: Use browser dev tools to inspect WS connections"
        close
    }
}