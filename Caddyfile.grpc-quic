# QUIC/HTTP3 → HTTP/2 → gRPC Protocol Gateway
# Caddy v2.8+ with full protocol translation for Legal AI Platform

{
    # Global settings
    admin off
    auto_https off
    log {
        output stdout
        format console
        level INFO
    }
}

# QUIC/HTTP3 Frontend (Port 443 with TLS for real QUIC)
:443 {
    # Enable HTTP/3 over QUIC with Alt-Svc advertisement
    header {
        Alt-Svc "h3=\":443\"; ma=86400"
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    }

    # Enable TLS (required for QUIC)
    tls internal {
        on_demand
    }

    # gRPC-Web to backend gRPC services (protobuf binary transport)
    @grpc_web {
        path /grpc/*
        header Content-Type application/grpc-web*
    }
    handle @grpc_web {
        reverse_proxy h2c://localhost:9090 {
            transport http {
                versions 2
            }
        }
    }

    # Legal AI API endpoints (JSON over HTTP/2)
    @legal_api {
        path /api/legal/*
    }
    handle @legal_api {
        reverse_proxy localhost:8095 {
            header_up X-Protocol "http2-json"
            header_up X-Client-Protocol {proto}
        }
    }

    # WebSocket upgrade for real-time streaming
    @websocket {
        header Connection *Upgrade*
        header Upgrade websocket
    }
    handle @websocket {
        reverse_proxy localhost:8095 {
            header_up Connection {>Connection}
            header_up Upgrade {>Upgrade}
        }
    }

    # SvelteKit Frontend
    handle {
        reverse_proxy localhost:5174 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # Compression for all responses
    encode {
        gzip 6
        zstd
        minimum_length 1024
    }
}

# HTTP/2 Fallback (Port 80)
:80 {
    # Redirect HTTP to HTTPS for QUIC upgrade
    redir https://{host}{uri} 301
}

# Development HTTP/2 endpoint (Port 8080)
:8080 {
    # Development CORS
    header {
        Access-Control-Allow-Origin "*"
        Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS, PATCH"
        Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With, grpc-web-content-type"
        Access-Control-Allow-Credentials "true"
    }

    # Handle preflight requests
    @options method OPTIONS
    handle @options {
        respond 200
    }

    # gRPC-Web proxy to backend (protobuf)
    @grpc_requests {
        path /grpc/*
        header Content-Type application/grpc-web*
    }
    handle @grpc_requests {
        reverse_proxy h2c://localhost:9090 {
            transport http {
                versions 2
            }
            header_up X-Protocol "grpc-web"
        }
    }

    # Legal AI JSON API
    @api_requests path /api/*
    handle @api_requests {
        reverse_proxy localhost:8095 {
            header_up X-Protocol "json-api"
            header_up X-Transport "http2"
        }
    }

    # Health check
    handle /health {
        respond "OK - QUIC/gRPC Gateway Ready" 200
    }

    # Default to frontend
    handle {
        reverse_proxy localhost:5174
    }
}

# gRPC Backend Service (Port 9090)
:9090 {
    # Pure gRPC/HTTP2 backend
    reverse_proxy localhost:8095 {
        transport http {
            versions 2
        }
        header_up Content-Type "application/grpc"
        header_up grpc-accept-encoding "gzip"
    }
}