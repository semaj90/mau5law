# Phase 70: PyTorch Fallback Service Dockerfile
FROM nvcr.io/nvidia/pytorch:24.01-py3

# Set working directory
WORKDIR /app

# Copy Python service
COPY python-services/pytorch_fallback_service.py /app/

# Install additional dependencies
RUN pip install --no-cache-dir fastapi uvicorn transformers accelerate bitsandbytes peft

# Create necessary directories
RUN mkdir -p /app/models

# Expose port
EXPOSE 8100

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8100/health || exit 1

# Run service
CMD ["python", "pytorch_fallback_service.py"]