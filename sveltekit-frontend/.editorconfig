# EditorConfig - Lock Svelte 5 indentation to prevent formatter corruption
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.svelte]
indent_style = tab
indent_size = 1
tab_width = 8

[*.{ts,js,mjs,cjs}]
indent_style = tab
indent_size = 1

[*.{json,jsonl,yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
