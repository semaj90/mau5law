{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Phase 14: Apply env + Phase 6 core check",
      "type": "shell",
      "command": "Copy-Item ../.env.phase14 ./.env -Force; npm run phase6:core",
      "options": {
        "cwd": "${workspaceFolder}/sveltekit-frontend"
      },
      "group": "build",
      "problemMatcher": ["$tsc"],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      }
    },
    {
      "label": "Dev: QUIC (Phase 14 env)",
      "type": "shell",
      "command": "Copy-Item ../.env.phase14 ./.env -Force; npm run dev:quic",
      "options": {
        "cwd": "${workspaceFolder}/sveltekit-frontend"
      },
      "isBackground": true,
      "group": "build",
      "problemMatcher": {
        "owner": "vite",
        "pattern": {
          "regexp": "^([^\\s].*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "ready in"
        }
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": false
      }
    },
    {
      "label": "Phase 14: Sync env to all services",
      "type": "shell",
      "command": "Copy-Item .env.phase14 sveltekit-frontend/.env -Force; Copy-Item .env.phase14 go-services/legal-engine/.env -Force; Copy-Item .env.phase14 go-services/rag-service/.env -Force; Copy-Item .env.phase14 backend/.env -Force; echo 'Phase 14 env synced to all services'",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      }
    },
    {
      "label": "Phase 14: Verify env loaded",
      "type": "shell",
      "command": "node -e \"require('dotenv').config({path:'.env'}); console.log('✅ OLLAMA_URL:', process.env.OLLAMA_URL); console.log('✅ DATABASE_URL:', process.env.DATABASE_URL?.substring(0,30)+'...'); console.log('✅ QDRANT_URL:', process.env.QDRANT_URL); console.log('✅ AUTH_COOKIE_NAME:', process.env.AUTH_COOKIE_NAME);\"",
      "options": {
        "cwd": "${workspaceFolder}/sveltekit-frontend"
      },
      "group": "test",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      }
    }
  ]
}
