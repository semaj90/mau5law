#!/usr/bin/env node
/**
 * SIMD-Ready Error Analyzer v3.0
 * Converts raw svelte-check output to structured JSONL + generates fix-plan.json
 *
 * Handles multi-line format:
 * file:line:col
 * Error: message
 * code snippet
 */

import crypto from 'crypto';
import fs from 'fs';
import readline from 'readline';

const inputFile = process.argv[2];
const outputJsonl = process.argv[3] || 'reports/errors.jsonl';
const outputFixPlan = process.argv[4] || 'reports/fix-plan.json';

if (!inputFile || !fs.existsSync(inputFile)) {
    console.error("❌ Input file not found:", inputFile);
    process.exit(1);
}

const events = [];
const errorsByCategory = {
    'import-type-misuse': [],
    'reactive-update': [],
    'async-function': [],
    'bits-ui-dialog': [],
    'bits-ui-field': [],
    'unused-variable': [],
    'type-mismatch': [],
    'missing-param': [],
    'other': []
};

const rl = readline.createInterface({
    input: fs.createReadStream(inputFile),
    crlfDelay: Infinity
});

let lineCount = 0;
let eventCount = 0;

console.log(`🔍 Parsing ${inputFile}...`);

// Multi-line parser state machine
let currentError = null;
const lines = [];

function stripAnsi(str) {
    return str ? str.replace(/[\u001b\u009b][[()#;?]*(?:[0-9]{1,4}(?:;[0-9]{0,4})*)?[0-9A-ORZcf-nqry=><]/g, '') : str;
}

function categorizeError(message, file) {
    message = message.toLowerCase();
    file = file.toLowerCase();

    if (message.includes("'import type'") || message.includes("import type")) {
        return 'import-type-misuse';
    }
    if (message.includes('non_reactive_update') || message.includes('non-reactive')) {
        return 'reactive-update';
    }
    if (message.includes('async') && (message.includes('onmount') || message.includes('$effect'))) {
        return 'async-function';
    }
    if (message.includes('dialog') || file.includes('dialog')) {
        return 'bits-ui-dialog';
    }
    if (message.includes('field') || file.includes('field')) {
        return 'bits-ui-field';
    }
    if (message.includes('declared but never used') || message.includes('unused')) {
        return 'unused-variable';
    }
    if (message.includes('is not assignable to type') || message.includes('type')) {
        return 'type-mismatch';
    }
    if (message.includes('missing') || message.includes('required')) {
        return 'missing-param';
    }
    return 'other';
}

function emitError(location, message, code) {
    if (!location) return;

    const parts = location.match(/^(.+?):(\d+):(\d+)/);
    if (!parts) return;

    const [_, file, lineNum, col] = parts;
    const fingerprint = crypto
        .createHash('sha256')
        .update(`${file}:${lineNum}:${message}`)
        .digest('hex')
        .substring(0, 12);

    const category = categorizeError(message, file);
    const event = {
        fingerprint,
        file,
        line: parseInt(lineNum),
        col: parseInt(col),
        message,
        code,
        category,
        severity: 'error',
        timestamp: new Date().toISOString()
    };

    events.push(event);
    errorsByCategory[category].push(event);
    eventCount++;

    // Emit to JSONL immediately (streaming)
    fs.appendFileSync(outputJsonl, JSON.stringify(event) + '\n', 'utf8');
}

rl.on('line', (rawLine) => {
    lineCount++;
    const line = stripAnsi(rawLine).trim();

    // Skip empty lines
    if (!line) {
        if (currentError && currentError.message) {
            emitError(currentError.location, currentError.message, currentError.code.join('\n'));
            currentError = null;
        }
        return;
    }

    // Pattern: file:line:col (start of error block)
    if (line.match(/^[A-Za-z]:.+?:\d+:\d+$/) || line.match(/^\/[\w\/\-._]+?:\d+:\d+$/)) {
        // Flush previous error if exists
        if (currentError && currentError.message) {
            emitError(currentError.location, currentError.message, currentError.code.join('\n'));
        }
        currentError = { location: line, message: '', code: [] };
        return;
    }

    if (!currentError) return;

    // Pattern: "Error: message" or "Warning: message"
    if (line.match(/^(Error|Warning):\s+/)) {
        currentError.message = line.replace(/^(Error|Warning):\s+/, '');
        return;
    }

    // Code lines (indented or continuation)
    if (currentError.message && (line.startsWith(' ') || line.startsWith('\t') || !line.match(/^[A-Z]/))) {
        currentError.code.push(line);
    }
}

rl.on('close', () => {
    // Flush last error
    if (currentError && currentError.message) {
        emitError(currentError.location, currentError.message, currentError.code.join('\n'));
    }

    // Progress display
    if (lineCount % 500 === 0) {
        process.stdout.write(`\r⏳ Parsed ${lineCount} lines, ${eventCount} errors classified`);
    }

    process.stdout.write('\n');
    console.log(`\n✅ Parsed complete: ${lineCount} lines, ${eventCount} events`);

    // JSONL already written line-by-line during parsing
    console.log(`📋 Wrote ${eventCount} events to ${outputJsonl}`);

    // ============================================================
    // Generate fix-plan.json (categorized + tiered)
    // ============================================================
    const fixPlan = {
        generated: new Date().toISOString(),
        summary: {
            totalErrors: eventCount,
            byCategory: Object.fromEntries(
                Object.entries(errorsByCategory).map(([cat, arr]) => [cat, arr.length])
            )
        },
        tiers: [
            {
                tier: 1,
                name: "Safe Deterministic Fixes",
                description: "Fixes with 100% confidence - auto-applied",
                categories: ['unused-variable'],
                transforms: [
                    {
                        id: 'remove-unused-vars',
                        pattern: 'unused-variable',
                        action: 'delete-declaration',
                        canApplyAuto: true,
                        risk: 'low'
                    }
                ],
                errorCount: errorsByCategory['unused-variable'].length,
                examples: errorsByCategory['unused-variable'].slice(0, 3)
            },
            {
                tier: 2,
                name: "Semi-Safe Async/Lifecycle Fixes",
                description: "Common patterns - auto-applied with verification",
                categories: ['async-function', 'reactive-update'],
                transforms: [
                    {
                        id: 'wrap-onmount-async',
                        pattern: 'async-function',
                        action: 'wrap-in-block',
                        canApplyAuto: true,
                        risk: 'medium'
                    },
                    {
                        id: 'fix-reactive-update',
                        pattern: 'reactive-update',
                        action: 'add-declare',
                        canApplyAuto: true,
                        risk: 'medium'
                    }
                ],
                errorCount: (errorsByCategory['async-function'].length + errorsByCategory['reactive-update'].length)
            },
            {
                tier: 3,
                name: "Manual Code Review Required",
                description: "Complex patterns - generates patch files for review",
                categories: ['import-type-misuse', 'type-mismatch', 'bits-ui-dialog', 'bits-ui-field', 'missing-param'],
                transforms: [
                    {
                        id: 'audit-import-types',
                        pattern: 'import-type-misuse',
                        action: 'generate-patch',
                        canApplyAuto: false,
                        risk: 'high'
                    },
                    {
                        id: 'audit-type-mismatch',
                        pattern: 'type-mismatch',
                        action: 'generate-patch',
                        canApplyAuto: false,
                        risk: 'high'
                    }
                ],
                errorCount: (
                    errorsByCategory['import-type-misuse'].length +
                    errorsByCategory['type-mismatch'].length +
                    errorsByCategory['bits-ui-dialog'].length +
                    errorsByCategory['bits-ui-field'].length +
                    errorsByCategory['missing-param'].length
                )
            }
        ],
        errors: {
            tier1: errorsByCategory['unused-variable'].slice(0, 10),
            tier2: [
                ...errorsByCategory['async-function'].slice(0, 5),
                ...errorsByCategory['reactive-update'].slice(0, 5)
            ],
            tier3: [
                ...errorsByCategory['import-type-misuse'].slice(0, 5),
                ...errorsByCategory['type-mismatch'].slice(0, 5)
            ]
        },
        nextSteps: [
            `Review reports/error-events.jsonl for complete error list`,
            `Apply Tier 1 fixes: node scripts/batch-merger-fixer.mjs --apply-safe --tier 1`,
            `Apply Tier 2 fixes (with verification): node scripts/batch-merger-fixer.mjs --apply-safe --tier 2`,
            `Review Tier 3 patch files in reports/patches/ manually`,
            `Rerun advanced-check.ps1 to verify fixes`
        ]
    };

    fs.writeFileSync(outputFixPlan, JSON.stringify(fixPlan, null, 2));
    console.log(`📊 Wrote fix-plan to ${outputFixPlan}`);

    // ============================================================
    // Summary
    // ============================================================
    console.log('\n✨ Analysis Complete!');
    console.log(`  🎯 Tier 1 (Safe): ${fixPlan.tiers[0].errorCount} errors`);
    console.log(`  🎯 Tier 2 (Semi-Safe): ${fixPlan.tiers[1].errorCount} errors`);
    console.log(`  🎯 Tier 3 (Manual): ${fixPlan.tiers[2].errorCount} errors`);
    console.log('\n📋 Next: Review fix-plan.json, then run batch-merger-fixer.mjs');
});


