# Use NVIDIA TensorRT base with pre-installed PyTorch (saves 2GB+ download)
FROM nvcr.io/nvidia/pytorch:24.12-py3

# Environment for your RTX 3060 Ti
ENV CUDA_VISIBLE_DEVICES=0
ENV NVIDIA_VISIBLE_DEVICES=all
ENV TORCH_CUDA_ARCH_LIST="8.6"
ENV LEGAL_AI_MODE=production

WORKDIR /app

# Verify existing installations (don't reinstall)
RUN python -c "import torch; print(f'✅ PyTorch {torch.__version__} already installed')" && \
    python -c "import torchvision; print(f'✅ TorchVision {torchvision.__version__} already installed')" && \
    nvidia-smi --query-gpu=name,memory.total,driver_version --format=csv

# Install only missing dependencies (use cache)
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --no-cache-dir \
    fastapi>=0.115.0 \
    uvicorn[standard] \
    ollama>=0.3.0 \
    scikit-learn>=1.3.0 \
    requests

# Copy your working legal AI system
COPY embedding_adapter_512.py .
COPY embedding_adapter_512.pkl .
COPY legal_vector_db_512.json .
COPY Legal_AI_Vector_Search_Complete_Guide.txt .

# Create optimized API server
RUN cat > legal_api_server.py << 'EOF'
#!/usr/bin/env python3
"""
Legal AI Vector Search API Server
Optimized for RTX 3060 Ti + TensorRT + Ollama
"""
import uvicorn
from fastapi import FastAPI, HTTPException
from embedding_adapter_512 import EmbeddingAdapter512
import torch
import time
import json

app = FastAPI(
    title="Legal AI Vector Search API",
    description="512-dimension embeddings for legal document analysis",
    version="1.0.0"
)

# Initialize adapter
print("🚀 Initializing Legal AI Vector Search...")
adapter = EmbeddingAdapter512()
print("✅ Legal AI adapter ready!")

@app.get("/health")
async def health_check():
    """Health check with GPU status"""
    return {
        "status": "healthy",
        "gpu_available": torch.cuda.is_available(),
        "gpu_name": torch.cuda.get_device_name(0) if torch.cuda.is_available() else None,
        "cuda_version": torch.version.cuda if torch.cuda.is_available() else None,
        "pytorch_version": torch.__version__,
        "adapter_loaded": adapter.pca_reducer is not None,
        "timestamp": time.time()
    }

@app.post("/embeddings")
async def generate_embeddings(request: dict):
    """Generate 512-dimension legal embeddings"""
    try:
        text = request.get("text", "")
        if not text.strip():
            raise HTTPException(status_code=400, detail="Text is required")

        start_time = time.time()
        embedding = adapter.get_legal_embedding_512(text)
        processing_time = (time.time() - start_time) * 1000  # ms

        return {
            "embedding": embedding.tolist(),
            "dimensions": len(embedding),
            "text_length": len(text),
            "processing_time_ms": round(processing_time, 2),
            "model": "embeddinggemma:latest",
            "status": "success"
        }
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))

@app.post("/similarity-search")
async def similarity_search(request: dict):
    """Search for similar legal clauses"""
    try:
        query = request.get("query", "")
        top_k = request.get("top_k", 5)

        if not query.strip():
            raise HTTPException(status_code=400, detail="Query is required")

        start_time = time.time()

        # Load vector database
        with open('legal_vector_db_512.json', 'r') as f:
            vector_db = json.load(f)

        # Get query embedding
        query_embedding = adapter.get_legal_embedding_512(query)

        # Calculate similarities
        import numpy as np
        similarities = []
        for entry in vector_db:
            stored_embedding = np.array(entry['embedding'])
            similarity = np.dot(query_embedding, stored_embedding) / (
                np.linalg.norm(query_embedding) * np.linalg.norm(stored_embedding)
            )
            similarities.append({
                **entry,
                'similarity': float(similarity)
            })

        # Sort and return top k
        similarities.sort(key=lambda x: x['similarity'], reverse=True)
        results = similarities[:top_k]

        processing_time = (time.time() - start_time) * 1000  # ms

        return {
            "results": results,
            "query": query,
            "query_embedding": query_embedding.tolist(),
            "total_documents": len(vector_db),
            "top_k": top_k,
            "processing_time_ms": round(processing_time, 2),
            "status": "success"
        }
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))

@app.get("/stats")
async def get_stats():
    """Get vector database statistics"""
    try:
        with open('legal_vector_db_512.json', 'r') as f:
            vector_db = json.load(f)

        clause_types = {}
        risk_levels = {}

        for entry in vector_db:
            clause_type = entry.get('clause_type', 'unknown')
            risk_level = entry.get('risk_level', 'unknown')

            clause_types[clause_type] = clause_types.get(clause_type, 0) + 1
            risk_levels[risk_level] = risk_levels.get(risk_level, 0) + 1

        return {
            "total_documents": len(vector_db),
            "clause_types": clause_types,
            "risk_levels": risk_levels,
            "embedding_dimensions": 512,
            "model": "embeddinggemma:latest",
            "status": "success"
        }
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))

if __name__ == "__main__":
    print("🚀 Starting Legal AI Vector Search API Server...")
    print("🎯 Optimized for RTX 3060 Ti + TensorRT")
    print("📊 Endpoint: http://0.0.0.0:8100")

    uvicorn.run(
        app,
        host="0.0.0.0",
        port=8100,
        log_level="info"
    )
EOF

RUN chmod +x legal_api_server.py

# Expose API port
EXPOSE 8100

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s \
    CMD python -c "import requests; requests.get('http://localhost:8100/health', timeout=5)" || exit 1

# Start optimized API server
CMD ["python", "legal_api_server.py"]