/**
 * Shared Redis Client (ioredis)
 * Centralizes configuration + connection reuse across services (BullMQ, workers, caches, etc.)
 * Handles Docker defaults, password injection, and safe reconnect helpers.
 */
import Redis, { type RedisOptions } from 'ioredis';
import { CONFIG } from '$lib/config/env.server';

type RedisStatusShape = { status?: string; connect?: () => Promise<void> };

const metaEnv =
  typeof import.meta !== 'undefined'
    ? ((import.meta as unknown as { env?: Record<string, string | undefined> }).env ?? undefined)
    : undefined;

export interface RedisResolvedConfig {
  url: string;
  password?: string;
}

export interface RedisClientOptions extends Partial<RedisOptions> {
  url?: string;
  password?: string;
}

function injectPassword(url: string, password?: string): string {
  if (!password) return url;
  try {
    const parsed = new URL(url);
    if (parsed.password) return url;
    parsed.username = parsed.username ?? '';
    parsed.password = password;
    return parsed.toString();
  } catch {
    if (url.startsWith('redis://')) {
      return `redis://:${encodeURIComponent(password)}@${url.slice('redis://'.length)}`;
    }
    return url;
  }
}

export function resolveRedisConfig(overrides?: RedisClientOptions): RedisResolvedConfig {
  const envUrl = metaEnv?.REDIS_URL ?? process.env.REDIS_URL;
  const envPassword = metaEnv?.REDIS_PASSWORD ?? process.env.REDIS_PASSWORD;

  const url = overrides?.url ?? envUrl ?? CONFIG.REDIS_URL ?? 'redis://localhost:6379';
  const password = overrides?.password ?? envPassword ?? (CONFIG.REDIS_PASSWORD || undefined);

  return { url: injectPassword(url, password), password: password || undefined };
}

function buildRedisOptions(overrides?: RedisClientOptions): [string, RedisOptions] {
  const { url, password } = resolveRedisConfig(overrides);
  const { url: _ignoredUrl, password: _ignoredPassword, ...rest } = overrides ?? {};

  const baseOptions: RedisOptions = {
    lazyConnect: true,
    maxRetriesPerRequest: 3,
    enableReadyCheck: true,
    retryStrategy: (times) => Math.min(times * 250, 4000),
    reconnectOnError: (err) => {
      const msg = err?.message ?? '';
      return msg.includes('READONLY') || msg.includes('ECONNRESET');
    },
    password,
    ...rest,
  };

  return [url, baseOptions];
}

export function createRedisClient(options?: RedisClientOptions): Redis {
  const [url, redisOptions] = buildRedisOptions(options);
  return new Redis(url, redisOptions);
}

const globalForRedis = globalThis as unknown as { sharedRedis?: Redis };

export const redis: Redis = globalForRedis.sharedRedis ?? createRedisClient();

globalForRedis.sharedRedis = redis;

redis.on('connect', () => {
  const host = redis?.options?.host ?? redis?.options?.path ?? 'redis';
  console.log(`[redis] connected to ${host}`);
});

redis.on('error', (err: Error) => {
  const message = err?.message ?? String(err);
  if (message.includes('NOAUTH')) {
    console.warn('[redis] authentication required. Supply REDIS_URL with credentials or REDIS_PASSWORD.');
    return;
  }
  console.error('[redis] error', message);
});

redis.on('end', () => {
  console.warn('[redis] connection ended. awaiting reconnect');
});

export async function ensureRedisReady(): Promise<void> {
  const candidate = redis as unknown as RedisStatusShape;
  if (candidate.status === 'ready') return;
  try {
    if (typeof candidate.connect === 'function') {
      await candidate.connect();
    }
  } catch (err) {
    console.error('[redis] ensure ready failed', err instanceof Error ? err.message : String(err));
  }
}

export async function shutdownRedis(): Promise<void> {
  try {
    if (redis.status === 'end') return;
    await redis.quit();
  } catch (err) {
    console.warn('[redis] graceful shutdown failed, forcing disconnect', err instanceof Error ? err.message : String(err));
    redis.disconnect();
  }
}

export default redis;
