{
  "extends": "./.svelte-kit/tsconfig.json",
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": false,
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": false,
    "noImplicitAny": false,
    "noImplicitReturns": false,
    "noImplicitThis": false,
    "strictNullChecks": false,
    "types": ["svelte", "vite/client", "@sveltejs/kit", "@webgpu/types", "node"],
    "lib": ["esnext", "DOM", "DOM.Iterable"],
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "isolatedModules": true
  },
  "include": ["src", "src/**/*.ts", "src/**/*.js", "src/**/*.svelte"],
  "exclude": [
    "node_modules",
    "build",
    "src/lib/server/thread-safe-postgres.ts",
    "src/lib/server/gpu-thread-coordinator.ts",
    "src/lib/services/gpu-cache-orchestrator.ts",
    "archived-components/**"
  ]
}