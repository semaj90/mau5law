# Optimized GPU Docker Configuration for Dynamic TensorRT Engine
# CUDA 12.8 + TensorRT 9.6+ + Ubuntu 22.04
FROM nvidia/cuda:12.8-devel-ubuntu22.04

# Set environment variables for CUDA and TensorRT
ENV CUDA_VERSION=12.8
ENV TENSORRT_VERSION=9.6.0
ENV CUDA_MPS_PIPE_DIRECTORY=/tmp/nvidia-mps
ENV CUDA_MPS_LOG_DIRECTORY=/tmp/nvidia-log
ENV LD_LIBRARY_PATH=/usr/local/cuda/lib64:$LD_LIBRARY_PATH

# Install system dependencies
RUN apt-get update && apt-get install -y \
    wget \
    gnupg2 \
    software-properties-common \
    build-essential \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

# Install TensorRT 9.6+ (compatible with CUDA 12.8)
RUN wget https://developer.download.nvidia.com/compute/machine-learning/repos/ubuntu2204/x86_64/nvidia-machine-learning-repo-ubuntu2204_1.0.0-1_amd64.deb \
    && dpkg -i nvidia-machine-learning-repo-ubuntu2204_1.0.0-1_amd64.deb \
    && apt-get update \
    && apt-get install -y \
        tensorrt \
        tensorrt-dev \
        tensorrt-libs \
        libnvinfer9 \
        libnvinfer-dev \
        libnvonnxparsers9 \
        libnvonnxparsers-dev \
        libnvinfer-plugin9 \
        libnvinfer-plugin-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Go 1.21+ for our services
RUN wget https://go.dev/dl/go1.21.6.linux-amd64.tar.gz \
    && tar -C /usr/local -xzf go1.21.6.linux-amd64.tar.gz \
    && rm go1.21.6.linux-amd64.tar.gz

ENV PATH=$PATH:/usr/local/go/bin

# Create CUDA MPS directories
RUN mkdir -p /tmp/nvidia-mps /tmp/nvidia-log
RUN chmod 755 /tmp/nvidia-mps /tmp/nvidia-log

# Set up workspace
WORKDIR /app

# Copy Go modules first for better caching
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build all GPU services
RUN go build -o gpu-memory-manager.exe gpu-memory-manager.go
RUN go build -o cuda-service-worker-simd.exe cuda-service-worker-simd.go
RUN go build -o legal-extraction-service.exe legal-extraction-service.go
RUN go build -o sequential-kg-service.exe sequential-kg-service.go

# Create startup script with GPU validation
RUN cat > /app/start-gpu-services.sh << 'EOF'
#!/bin/bash
set -e

echo "🚀 Starting GPU-optimized Legal AI Services"
echo "CUDA Version: ${CUDA_VERSION}"
echo "TensorRT Version: ${TENSORRT_VERSION}"

# Validate GPU access
echo "📊 GPU Status:"
nvidia-smi --query-gpu=name,memory.total,memory.used,utilization.gpu --format=csv,noheader,nounits

# Start CUDA MPS (Multi-Process Service)
echo "🔧 Starting CUDA MPS..."
nvidia-cuda-mps-control -d
echo "set_default_active_thread_percentage 80" | nvidia-cuda-mps-control
echo "✅ CUDA MPS Status:"
nvidia-cuda-mps-control -s

# Start services in background
echo "🚀 Starting GPU Memory Manager (8107)..."
PORT=8107 ./gpu-memory-manager.exe &

echo "🚀 Starting CUDA Service Worker (8097)..."
DATABASE_URL="${DATABASE_URL:-postgres://legal_admin:123456@postgres:5432/legal_ai_db}" \
PORT=8097 ./cuda-service-worker-simd.exe &

echo "🚀 Starting Legal Extraction Service (8098)..."
PORT=8098 ./legal-extraction-service.exe &

echo "🚀 Starting Knowledge Graph Service (8099)..."
PORT=8099 ./sequential-kg-service.exe &

# Wait for all services to start
sleep 5

# Health check all services
echo "🔍 Health Check:"
curl -s http://localhost:8107/api/v1/gpu/stats | jq '.total_vram_mb, .mps_enabled' || echo "GPU Manager: Starting..."
curl -s http://localhost:8097/api/v1/health | jq '.gpu_model' || echo "CUDA Service: Starting..."
curl -s http://localhost:8098/api/v1/health | jq '.status' || echo "Extraction Service: Starting..."
curl -s http://localhost:8099/api/v1/health | jq '.status' || echo "Knowledge Graph: Starting..."

echo "✅ All services started successfully!"
echo "📊 Monitor GPU usage: watch -n1 nvidia-smi"
echo "🔧 MPS Status: nvidia-cuda-mps-control -s"

# Keep container running
wait
EOF

RUN chmod +x /app/start-gpu-services.sh

# Install jq for JSON parsing in health checks
RUN apt-get update && apt-get install -y jq curl && rm -rf /var/lib/apt/lists/*

# Expose all service ports
EXPOSE 8097 8098 8099 8107

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8107/api/v1/gpu/stats || exit 1

# Start all GPU services
CMD ["/app/start-gpu-services.sh"]