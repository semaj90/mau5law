{
  "extends": "./.svelte-kit/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "allowJs": true,
    "checkJs": true,
    "verbatimModuleSyntax": true,
    "sourceMap": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "isolatedModules": true,
    "types": [
      "svelte",
      "vite/client",
      "@sveltejs/kit",
      "@webgpu/types",
      "node"
    ],
    "incremental": false,
    "tsBuildInfoFile": null,
    "noImplicitAny": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitReturns": false
  },
  "include": ["src/**/*.d.ts", "src/**/*.ts", "src/**/*.svelte", "src/lib/utils/bits-ui-ssr.disabled", "src/lib/utils/bits-ui-ssr.disabled"],
  "exclude": [
    "node_modules",
    "build",
    ".svelte-kit",
    "dist",
    "archived/**",
    "archived-components/**",
    ".svelte-check-tmp/**",
    "../.rag-metrics/**",
    "src/tests/**",
    "src/stories/**",
    "src/lib/experimental/**",
    "src/lib/ai/_experimental/**",
    "src/lib/examples/**",
    "src/routes/api/ai/gpu/**",
    "src/lib/components/gpu/**",
    "src/lib/engines/**",
    "src/lib/gpu/**",
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/node_modules/**",
    "src/proto/**",
    "src/**/*.js",
    "src/grpc/**",
    "src/flatbuf/**",
    "src/wasm/**",
    "**/*.worker.ts",
    "**/*.sw.ts",
    "**/service-worker.ts"
  ]
}
