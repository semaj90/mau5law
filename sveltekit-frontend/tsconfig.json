{
  "extends": "./.svelte-kit/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": false,
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": false,
    "noImplicitAny": false,
    "noImplicitReturns": false,
    "noImplicitThis": false,
    "strictNullChecks": false,
    "types": ["svelte", "vite/client", "@sveltejs/kit", "@webgpu/types", "node"],
    "verbatimModuleSyntax": false,
    "noEmit": true,
    "isolatedModules": false,
    "paths": {
      "$lib": ["./src/lib"],
      "$lib/*": ["./src/lib/*"],
      "$components": ["./src/lib/components"],
      "$components/*": ["./src/lib/components/*"],
      "$stores": ["./src/lib/stores"],
      "$stores/*": ["./src/lib/stores/*"],
      "$utils": ["./src/lib/utils"],
      "$utils/*": ["./src/lib/utils/*"],
      "$types": ["./src/lib/types"],
      "$types/*": ["./src/lib/types/*"]
    }
  },
  "include": ["src", "src/**/*.ts", "src/**/*.js", "src/**/*.svelte"],
  "exclude": [
    "node_modules",
    "build",
    "src/lib/server/thread-safe-postgres.ts",
    "src/lib/server/gpu-thread-coordinator.ts",
    "src/lib/services/gpu-cache-orchestrator.ts",
    "archived-components/**"
  ]
}