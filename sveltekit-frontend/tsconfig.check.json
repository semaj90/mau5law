{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "skipLibCheck": true,
    "checkJs": false,
    "isolatedModules": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.svelte",
    "src/**/*.d.ts"
  ],
  "exclude": [
    "node_modules/**",
    ".svelte-kit/**",
    "dist/**",
    "build/**",
    // Exclude junk/backup folders during migration
    "src/**/*.bak.*",
    "src/**/*.bak/**",
    "src/lib/ai.bak/**",
    "src/**/_disabled/**",
    "src/**/_yorha_legacy/**",
    "**/*.any-backup",
    "error-files/**",
    // Temporarily exclude proto/grpc generated files
    "src/proto/**"
  ]
}
