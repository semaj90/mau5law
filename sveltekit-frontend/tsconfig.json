{
  "extends": "./.svelte-kit/tsconfig.json",
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": true,
    "types": [
      "svelte",
      "vite/client",
      "@sveltejs/kit",
      "@webgpu/types",
      "node"
    ],
    "lib": ["esnext", "DOM", "DOM.Iterable"],
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "isolatedModules": true,
    "sourceMap": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
    // baseUrl and paths removed - use svelte.config.js kit.alias instead
    // This prevents conflicts with SvelteKit's auto-generated tsconfig.json
  },
  "include": [
    "src",
    "src/**/*.ts",
    "src/**/*.js",
    "src/**/*.svelte",
    "types.d.ts"
  ],
  "exclude": [
    "node_modules",
    "build",
    ".svelte-kit",
    "dist",
    "archived-components/**",
    ".svelte-check-tmp/**",
    "../.rag-metrics/**",
    "src/tests/**",
    "src/stories/**",
    "src/lib/experimental/**",
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/node_modules/**",
    "src/lib/server/thread-safe-postgres.ts",
    "src/lib/server/gpu-thread-coordinator.ts",
    "src/lib/services/gpu-cache-orchestrator.ts",
    "src/lib/services/webgpu-texture-streaming.ts",
    "src/lib/services/chr-rom-mipmap-integration.ts",
    "src/lib/types/drizzle-enhanced.d.ts",
    // keep other shims included for TS resolution
    // shim files are referenced via paths mapping above
    "src/proto/**",
    "src/grpc/**",
    "src/flatbuf/**",
    "src/wasm/**",
    "src/workers/**",
    "**/*.worker.ts",
    "**/*.sw.ts",
    "**/service-worker.ts"
  ]
}
